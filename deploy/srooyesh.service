# ======================================================================
#  systemd service — اجرای دائم روی لینوکس (بدون Docker)
#
#  نصب:
#    sudo cp deploy/srooyesh.service /etc/systemd/system/
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now srooyesh
#  لاگ زنده:   journalctl -u srooyesh -f
#  توقف:       sudo systemctl stop srooyesh
#
#  ⚠️ مسیرها و User را مطابق سرور خودت تنظیم کن.
# ======================================================================
[Unit]
Description=Srooyesh Lead Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=srooyesh
WorkingDirectory=/opt/srooyesh
# اگر venv داری مسیر پایتونِ venv را بگذار، وگرنه python3 سیستم
ExecStart=/opt/srooyesh/venv/bin/python main.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
