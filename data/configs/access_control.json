{
  "version": "4.3.0",
  "description": "کنترل دسترسی هوش — v4.3.0: هوش می‌تواند همه چیز را ببیند (فقط خواندن) اما فقط در محدودهٔ write مجاز است بنویسد.",

  "read": {
    "allow": [
      "core/**/*.py",
      "collectors/**/*.py",
      "handlers/**/*.py",
      "analyzers/**/*.py",
      "tests/**/*.py",
      "scripts/**/*.py",
      "data/**",
      "docs/**",
      "storage/logs/**",
      "storage/reports/**",
      "storage/brain/**",
      "storage/safe_brain/**",
      "data/configs/access_control.json",
      "storage/sessions/**",
      "storage/database/*.db",
      "storage/database/*.db-wal",
      "storage/database/*.db-shm",
      "storage/database/*.db-journal",
      "storage/backups/**",
      "storage/media/**",
      "*.py",
      "*.md",
      "*.txt",
      "*.ini",
      "*.json",
      "*.yaml",
      "*.yml",
      "*.toml",
      "*.bat",
      "*.sh",
      "Dockerfile",
      "docker-compose.yml",
      ".gitignore",
      "requirements.txt",
      "pytest.ini",
      "pyproject.toml",
      "README.md",
      "tests/**"
    ],
    "deny": [
      ".env",
      ".env.*"
    ]
  },

  "write": {
    "allow": [
      "data/runtime/**",
      "data/sources/target_groups.txt",
      "data/sources/glossary.txt",
      "data/sources/web_sources.txt",
      "data/sources/linkedin_searches.txt",
      "data/prompts/bot_knowledge.md",
      "storage/reports/**",
      "storage/brain/**",
      "storage/safe_brain/**",
      "storage/requests.jsonl",
      "storage/test_reports/**",
      "tests/**"
    ],
    "deny": [
      ".env",
      ".env.*",
      "data/configs/**",
      "core/**",
      "collectors/**",
      "handlers/**",
      "analyzers/**",
      "scripts/**",
      "data/products.py",
      "data/products_en.py",
      "main.py",
      "config.py",
      "panel.py",
      "login.py",
      "storage/database/**",
      "storage/sessions/**",
      "storage/backups/**",
      "storage/media/**"
    ]
  },

  "database": {
    "read_tables": ["*"],
    "write_tables": [],
    "allow_delete": false,
    "max_rows_select": 100000
  },

  "settings": {
    "read": ["*"],
    "write": [
      "BALE_POLL_SECONDS", "EITAA_POLL_SECONDS",
      "RUBIKA_POLL_SECONDS", "TELEGRAM_POLL_SECONDS",
      "WHATSAPP_POLL_SECONDS", "LINKEDIN_POLL_SECONDS",
      "INSTAGRAM_POLL_SECONDS",
      "BALE_ENABLED", "EITAA_ENABLED", "RUBIKA_ENABLED",
      "TELEGRAM_ENABLED", "WHATSAPP_ENABLED",
      "WEB_ENABLED", "LINKEDIN_ENABLED", "INSTAGRAM_ENABLED",
      "BALE_MAX_CHATS", "EITAA_MAX_CHATS", "WHATSAPP_MAX_CHATS",
      "BALE_MESSAGES_PER_CHAT", "EITAA_MESSAGES_PER_CHAT",
      "WHATSAPP_MESSAGES_PER_CHAT",
      "BALE_BACKFILL_SCROLLS", "EITAA_BACKFILL_SCROLLS",
      "WHATSAPP_BACKFILL_SCROLLS",
      "BALE_CHAT_DELAY", "EITAA_CHAT_DELAY", "WHATSAPP_CHAT_DELAY",
      "AI_PRIORITY", "AI_ENABLED",
      "LOG_LEVEL", "LOG_TO_FILE", "LOG_JSON",
      "OBS_PORT", "OBS_ENABLED",
      "BRAND_TOKEN_ENABLED", "BRAND_TOKEN_MIN_LEN",
      "KEYWORDS_RELOAD_SECONDS", "KEYWORDS_ONLY",
      "STORAGE_REQUIRE_T1", "STORAGE_ALLOWED_TIERS",
      "LEAD_ALERTS_ENABLED", "LEAD_ALERT_MIN_SCORE", "LEAD_ALERT_TIERS",
      "REPORT_ENABLED", "REPORT_DAILY_TIME",
      "REPORT_WEEKLY_DAY", "REPORT_WEEKLY_TIME",
      "MONITOR_ENABLED", "MONITOR_INTERVAL_SECONDS",
      "SELF_MONITOR_ENABLED", "SELF_MONITOR_INTERVAL",
      "SELF_MONITOR_ERROR_THRESHOLD", "SELF_MONITOR_STALE_MINUTES",
      "KEEP_MEDIA_DAYS", "KEEP_REPORTS_DAYS", "KEEP_MESSAGES_DAYS",
      "CLEANUP_INTERVAL_HOURS",
      "BACKUP_POKE_SECONDS", "DAILY_BACKUP_HOURS",
      "KEEP_DAILY_BACKUPS", "KEEP_FULL_BACKUPS", "FULL_BACKUP_DAYS"
    ],
    "deny": [
      "ADMIN_IDS", "ADMIN_ENABLED", "ADMIN_PLATFORM",
      "DEEPSEEK_API_KEY", "MEMORY_API_KEY",
      "DB_PASSWORD", "DB_HOST", "DB_USER", "DB_NAME",
      "RUBIKA_PHONE", "RUBIKA_PASSWORD",
      "BALE_PHONE", "BALE_PASSWORD",
      "EITAA_PHONE", "EITAA_PASSWORD",
      "WHATSAPP_PHONE",
      "LINKEDIN_EMAIL", "LINKEDIN_PASSWORD",
      "TELEGRAM_API_ID", "TELEGRAM_API_HASH", "TELEGRAM_PHONE",
      "MAIN_SKIP_VENV_CHECK",
      "FULL_ACCESS", "USE_API_MEMORY"
    ]
  },

  "platforms": {
    "toggleable": [
      "eitaa", "bale", "rubika", "telegram",
      "whatsapp", "web", "linkedin", "instagram"
    ],
    "status_check": true,
    "allow_restart_collector": true
  },

  "execute": {
    "allow": [
      "git status", "git diff", "git log", "git branch",
      "git show", "git rev-parse",
      "python -m pytest", "pytest",
      "pip list", "pip show",
      "dir", "ls", "type", "cat", "head", "tail",
      "systeminfo", "tasklist", "netstat", "ping"
    ],
    "deny": [
      "python -c", "python -m http",
      "rm -rf", "rmdir /s", "del /f /s",
      "format", "shutdown", "reboot", "mkfs",
      "dd if=", "chmod 777", "sudo", "su ",
      "curl ", "wget ", "nc ",
      ":(){ :|:& };:"
    ]
  },

  "safety": {
    "backup_before_write": true,
    "require_confirmation": [
      "write_file", "edit_file", "delete_file", "move_file",
      "git_commit", "kill_process", "restart_platform",
      "set_setting", "toggle_platform", "change_poll_interval"
    ],
    "max_file_size_mb": 20,
    "max_command_timeout_sec": 300,
    "max_db_rows": 100000,
    "log_all_writes": true
  },

  "ai_limits": {
    "max_calls_per_hour": 100,
    "max_tokens_per_call": 4096,
    "allow_self_upgrade": false,
    "allow_git_push": false,
    "allow_kill_process": false
  }
}