{
  "version": "1.0.0",
  "matching": {
    "fuzzy_threshold": 0.72,
    "min_trigger_length": 4,
    "longest_trigger_wins": true
  },
  "learning": {
    "min_repeat_for_auto_promote": 2,
    "max_unknown_lines": 2000,
    "max_learned_rules": 500
  },
  "security": {
    "max_query_length": 500,
    "blocked_keywords": ["DROP", "DELETE", "UPDATE", "INSERT", "ALTER", "TRUNCATE", "REPLACE", "ATTACH", "PRAGMA", "VACUUM"],
    "allowed_prefix": "SELECT"
  },
  "ai": {
    "fallback_chain": ["rules", "fuzzy", "ollama", "deepseek"],
    "confidence_threshold": 0.6,
    "timeout_seconds": 60
  }
}