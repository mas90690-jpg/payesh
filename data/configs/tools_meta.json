  "tool_definitions": [
    {
      "type": "function",
      "function": {
        "name": "read_file",
        "description": "خواندن یک فایل با پشتیبانی از chunk برای فایل‌های بزرگ. برای فایل‌های تا ۱۰۰KB کامل می‌خواند. برای بزرگ‌تر، خودکار chunk می‌کند و به شماره تکه ارجاع می‌دهد (chunk=0, 1, 2, ...). شماره خط هم نشان می‌دهد.\nخروجی: متن فایل با شماره خط یا پیام خطا",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "مسیر فایل"
            },
            "chunk": {
              "type": "integer",
              "description": "شمارهٔ تکه (0 = اول)",
              "default": 0
            },
            "chunk_size": {
              "type": "integer",
              "description": "اندازهٔ هر تکه به کاراکتر",
              "default": 100000
            }
          },
          "required": [
            "path"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "read_all",
        "description": "خواندن کامل یک فایل (بدون chunk). برای فایل‌های بزرگ ممکن است بریده شود. برای خواندن تکه‌تکه از read_file با chunk استفاده کن.\nخروجی: متن کامل فایل",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "مسیر فایل"
            },
            "max_chars": {
              "type": "integer",
              "description": "سقف کاراکتر (پیش‌فرض 2M)"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "read_chunk",
        "description": "خواندن یک تکهٔ مشخص از فایل. معادل read_file با پارامتر chunk.\nخروجی: متن تکه با شماره خط",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "مسیر فایل"
            },
            "chunk": {
              "type": "integer",
              "description": "شمارهٔ تکه (0-based)"
            }
          },
          "required": [
            "path",
            "chunk"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "read_lines",
        "description": "خواندن بازهٔ مشخصی از خطوط فایل. برای خواندن تابع/کلاس خاص عالی است. مثال: خطوط ۱۰۰ تا ۲۰۰ یک فایل.\nخروجی: خطوط با شماره",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "مسیر فایل"
            },
            "start_line": {
              "type": "integer",
              "description": "خط شروع (1-based)",
              "default": 1
            },
            "end_line": {
              "type": "integer",
              "description": "خط پایان",
              "default": 100
            }
          },
          "required": [
            "path"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "read_range",
        "description": "خواندن بازهٔ مشخصی از کاراکترها. برای فایل‌های باینری/بزرگ مفید است.\nخروجی: بازهٔ کاراکتر",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "مسیر فایل"
            },
            "start_char": {
              "type": "integer",
              "description": "شروع (0-based)",
              "default": 0
            },
            "end_char": {
              "type": "integer",
              "description": "پایان",
              "default": 100000
            }
          },
          "required": [
            "path"
          ]
        }
      }
    },
