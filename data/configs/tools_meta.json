    {
      "type": "function",
      "function": {
        "name": "audit_code",
        "description": "بررسی کامل کد پایتون با pyflakes + flake8 (+ vulture + bandit). پیدا کردن: import اضافه، متغیر استفاده‌نشده، اسم تعریف‌نشده، f-string بی‌placeholder، غلط تایپی، مشکلات منطقی. خروجی: dict ساختاریافته با دسته‌بندی.\nخروجی: dict با summary + details + raw_output",
        "parameters": {
          "type": "object",
          "properties": {
            "paths": {
              "type": "string",
              "description": "مسیرها با فاصله (پیش‌فرض: core/ handlers/ collectors/ analyzers/ main.py)",
              "default": "core/ handlers/ collectors/ analyzers/ main.py"
            },
            "include_flake8": {
              "type": "boolean",
              "description": "بررسی با flake8 (پیش‌فرض True)",
              "default": true
            },
            "include_vulture": {
              "type": "boolean",
              "description": "بررسی کد بلااستفاده (کندتر)",
              "default": false
            },
            "include_bandit": {
              "type": "boolean",
              "description": "بررسی امنیت (کندتر)",
              "default": false
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "audit_file",
