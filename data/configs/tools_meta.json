    {
      "type": "function",
      "function": {
        "name": "list_directory",
        "description": "لیست محتویات یک پوشه. با recursive=True زیرپوشه‌ها هم اسکن می‌شوند. با pattern می‌توان فیلتر کرد.\nخروجی: لیست فایل‌ها و پوشه‌ها",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "مسیر پوشه",
              "default": "."
            },
            "recursive": {
              "type": "boolean",
              "description": "اسکن زیرپوشه‌ها",
              "default": false
            },
            "pattern": {
              "type": "string",
              "description": "فیلتر glob (مثل *.py)",
              "default": ""
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "write_file",
        "description": "نوشتن یا بازنویسی یک فایل (نیاز به تأیید). ⚠️ روی فایل‌های دانشی (bot_knowledge.md, persona.md, system.md, ai_system_prompt.md) قفل است — از append_knowledge استفاده کن.\nخروجی: ✅ موفق / ❌ خطا",
