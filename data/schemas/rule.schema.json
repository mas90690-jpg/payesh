{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rule",
  "type": "object",
  "required": ["name", "triggers", "action"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 50
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 2, "maxLength": 200},
          {"type": "array", "items": {"type": "string"}, "minItems": 1}
        ]
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["sql", "callable", "text", "template"]}
      }
    },
    "learned": {"type": "boolean", "default": false},
    "source": {"enum": ["core", "user", "ai", "promoted"], "default": "core"}
  }
}