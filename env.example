# ======================================================================
#  سیستم پایش هوشمند سرنخ — تنظیمات اصلی (.env)
#  هر مقدار توضیح دارد. فقط چیزهایی که لازم داری را عوض کن.
# ======================================================================

# ======================================================================
#  ۱) دیتابیس
# ======================================================================
DATABASE_TYPE=sqlite          # sqlite (پیش‌فرض) یا postgres
# --- فقط در صورت استفاده از postgres لازم است ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=lead_monitor

# ======================================================================
#  ۲) پیام‌رسان‌ها  (true = فعال، false = خاموش)
#  ⚠️ ورود هر کدام یک‌بار با: python login.py
# ======================================================================

# ---------- بله (Bale) — کاربر، ورود با شماره + کد پیامک ----------
BALE_TYPE=user
BALE_PHONE=09134039935
BALE_PASSWORD=your_bale_password_here
BALE_ENABLED=true

# ---------- روبیکا (Rubika) — کاربر، ورود با شماره + کد پیامک ----------
RUBIKA_PHONE=09134039935
RUBIKA_PASSWORD=your_rubika_password_here
RUBIKA_ENABLED=true

# ---------- ایتا (Eitaa) — کاربر، ورود با مرورگر (web.eitaa.com) ----------
EITAA_PHONE=09134039935
EITAA_PASSWORD=your_eitaa_password_here
EITAA_ENABLED=true

# ---------- تلگرام (Telegram) — کاربر، نیاز به api_id/api_hash از my.telegram.org ----------
# ⚠️ IMPORTANT: TELEGRAM_API_ID باید عددی باشد (مثل 123456)، نه رشته!
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE=+989134039935
TELEGRAM_ENABLED=true

# ---------- واتساپ (WhatsApp) — کاربر، ورود با QR (web.whatsapp.com) ----------
# ⚠️ در ایران معمولاً نیاز به VPN دارد
WHATSAPP_PHONE=+989134039935
WHATSAPP_ENABLED=true

# ----------لینکدین (LinkedIn) — کاربر، ورود با مرورگر (www.linkedin.com)
# ⚠️ برای تست سریع، poll را 60 بگذار. برای سرور واقعی، 600 (۱۰ دقیقه) مناسب است.
LINKEDIN_ENABLED=true
LINKEDIN_EMAIL=MSS90690@GMAIL.com
LINKEDIN_PASSWORD=your_linkedin_password_here
LINKEDIN_POLL_SECONDS=600
# بقیه تنظیمات اختیاری (پیش‌فرض‌های خوبی دارند):
# LINKEDIN_MAX_RESULTS=15
# LINKEDIN_SEARCH_DELAY=6
# LINKEDIN_SCROLLS=3

# ---------- منابع وب (سایت/صفحه) — لینک‌ها در data/web_sources.txt ----------
WEB_ENABLED=true
WEB_TRANSLATE=true      # ترجمهٔ فارسی محتوا با واژه‌نامهٔ اختصاصی (data/glossary.txt)
WEB_MAX_PAGES=40         # حداکثر صفحه در حالت site (عدد منطقی)
WEB_TIMEOUT=20

# ======================================================================
#  ۳) نگه‌داری و پاک‌سازی خودکار (Retention)  — ۰ = هرگز پاک نشود
# ======================================================================
KEEP_MEDIA_DAYS=7
KEEP_REPORTS_DAYS=30
KEEP_MESSAGES_DAYS=0
CLEANUP_INTERVAL_HOURS=24

# ======================================================================
#  ۴) مانیتورینگ سیستم  (آستانه‌ها بالاست تا لاگ پرنویز نشود)
# ======================================================================
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=120
MONITOR_CPU_ALERT=90
MONITOR_RAM_ALERT=90
MONITOR_DISK_ALERT=70

# ======================================================================
#  ۵) پشتیبان‌گیری (Backup)
# ======================================================================
DAILY_BACKUP_HOURS=24
KEEP_DAILY_BACKUPS=10
KEEP_FULL_BACKUPS=2
FULL_BACKUP_DAYS=7

# ======================================================================
#  ۶) گزارش خودکار
# ======================================================================
REPORT_ENABLED=true
REPORT_DAILY_TIME=08:00
REPORT_WEEKLY_DAY=Saturday
REPORT_WEEKLY_TIME=08:10

# ======================================================================
#  ۷) اعلان‌ها (اختیاری — ارسال هشدار سرنخ مهم به یک ربات تلگرام)
# ======================================================================
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# ======================================================================
#  ۸) مغز هوشمند (حافظه API، دسترسی کامل و کلید DeepSeek)
# ======================================================================
# کلید API DeepSeek (برای مغز اصلی)
DEEPSEEK_API_KEY=sk-...   # <-- کلید واقعی را اینجا بگذار (جای ...)

# دسترسی کامل: تمام محدودیت‌های امنیتی را دور می‌زند (فقط در محیط ایزوله)
FULL_ACCESS=false

# استفاده از حافظه API به‌جای ChromaDB محلی
USE_API_MEMORY=false

# آدرس سرور حافظه API (مثلاً http://localhost:8080 یا سرویس ابری)
MEMORY_API_URL=

# کلید API حافظه (در صورت نیاز)
MEMORY_API_KEY=

# ======================================================================
#  ۹) تنظیمات پیشرفته (همه پیش‌فرضِ خوب دارند — فقط در صورت نیاز عوض کن)
# ======================================================================

# --- ذخیره‌سازی و کلیدواژه ---
KEYWORDS_ONLY=true
KEYWORDS_RELOAD_SECONDS=5

# --- مرورگر برای اسکرپرها (ایتا/واتساپ/لینکدین) ---
CHROME_PATH=
BROWSER_HEADLESS=true

# --- فاصلهٔ خواندن (poll) و سقفِ کارِ اسکرپرهای مرورگری ---
EITAA_POLL_SECONDS=180
EITAA_MAX_CHATS=15
WHATSAPP_POLL_SECONDS=180
WHATSAPP_MAX_CHATS=15
LINKEDIN_MONITOR_FEED=true
LINKEDIN_MAX_FEED_POSTS=25

# --- Catch-up: سقفِ خواندنِ پیام‌های عقب‌افتاده بعد از خاموشی ---
TELEGRAM_HISTORY_LIMIT=3000
BALE_HISTORY_LIMIT=200
RUBIKA_HISTORY_LIMIT=200

# --- لاگِ ساختارمند (JSON) ---
LOG_LEVEL=INFO
LOG_JSON=true
LOG_TO_FILE=true
LOG_CONSOLE=true
LOG_MAX_MB=10
LOG_BACKUPS=30

# --- سرورِ سلامت/متریک (Observability) ---
OBS_ENABLED=true
OBS_HOST=0.0.0.0
OBS_PORT=8787

# --- «مغز» (هوشِ محلی + پنلِ مدیر + چتِ زنده) ---
AI_ENABLED=true
ADMIN_ENABLED=true
ADMIN_PLATFORM=bale
ADMIN_IDS=                     # خالی=pairing؛ بعد از دریافت آی‌دی عددی از لاگ، اینجا بگذار (مثلاً 123456789)
AI_ASSISTANT_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=30s
AI_TIMEOUT=120
LEAD_ALERTS_ENABLED=false

# --- پایشگرِ خودکارِ مشکلات (مستقل از هوش) ---
SELF_MONITOR_ENABLED=true
SELF_MONITOR_INTERVAL=600
SELF_MONITOR_ERROR_THRESHOLD=5
SELF_MONITOR_STALE_MINUTES=60