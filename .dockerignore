# .dockerignore — چیزهایی که نباید داخل image برود
.git
.gitignore
.github

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# venv
venv/
.venv/
env/
ENV/

# Secrets (بحرانی)
.env
.env.*
!.env.example
*.key
*.pem
*.crt

# Runtime data (باید volume شود، نه image)
storage/
data/runtime/

# Debug
*.log
*.tmp
bot.pid

# IDE
.idea/
.vscode/
*.swp