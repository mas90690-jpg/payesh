UNKNOWN_FILE = data_paths.UNKNOWN_QUESTIONS
STATS_FILE = data_paths.RULE_STATS
TEMPLATES_FILE = data_paths.TEMPLATES
CUSTOM_KW_FILE = data_paths.KEYWORDS_CUSTOM
LOG_FILE = LOGS_DIR / "app.jsonl"

# ══════════════════════════════════════════════════════
# آستانهها
# ══════════════════════════════════════════════════════
_UNKNOWN_MIN_REPEAT = 2
_FUZZY_THRESHOLD = 0.72
_MAX_UNKNOWN_LINES = 2000
_MIN_ANSWER_LEN = 4
_MAX_TRIGGER_LEN = 120
_MIN_TRIGGER_LEN = 2
_MIN_KW_LEN = 2
_MAX_KW_LEN = 100

# seek از انتهای لاگ (برای read سریع)
_LOG_TAIL_BYTES = 512 * 1024
_UNKNOWN_TAIL_BYTES = 512 * 1024

# آستانههای هشدار (میلیثانیه)
_SLOW_PROCESS_MS = 3000
_SLOW_ACTION_MS = 2000

# پیشنمایش لاگ
_LOG_PREVIEW_LEN = 60

_BAD_ANSWER_MARKERS = (
    "خطای API", "خطا در API", "Insufficient Balance",
    "Error code:", "error code:", "rate limit", "RateLimitError",
    "timed out", "TimeoutError", "ConnectionError",
    "Traceback", "Exception:", "Stack trace", "HTTP 4", "HTTP 5",
    "not available", "در دسترس نیست", "موجودی حساب",
    "WinDoctor:", "هوش مصنوعی در دسترس نیست",
    "متوجه نشدم", "مغز مشغول است",
    "درخواست قابلیت جدید ثبت شد",
)

_BAD_ANSWER_PREFIXES = ("❌", "⚠️", "🚫", "⛔")

_PLATFORM_FA: dict[str, str] = {
    "ایتا": "eitaa", "بله": "bale", "روبیکا": "rubika",
    "تلگرام": "telegram", "واتساپ": "whatsapp",
    "لینکدین": "linkedin", "وب": "web", "سایت": "web",
    "eitaa": "eitaa", "bale": "bale", "rubika": "rubika",
    "telegram": "telegram", "whatsapp": "whatsapp",
    "linkedin": "linkedin", "web": "web",
    "اینستاگرام": "instagram",
    "اینستا": "instagram",
}


# ══════════════════════════════════════════════════════
# helpers
# ══════════════════════════════════════════════════════
def _md5_short(text: str) -> str:
    """md5 hex (FIPS-safe) — ۱۲ کاراکتر اول."""
    h = hashlib.md5(text.encode("utf-8"), usedforsecurity=False)
    return h.hexdigest()[:12]


def _tail_lines(path: Path, max_bytes: int) -> list[str]:
    """آخرین خطوط فایل بدون خوندن کل آن."""
    try:
        if not path.exists():
            return []
        size = path.stat().st_size
        with open(str(path), "rb") as f:
            if size > max_bytes:
                f.seek(-max_bytes, os.SEEK_END)
                f.readline()
            data = f.read()
        return data.decode("utf-8", errors="ignore").splitlines()
    except Exception as e:
        log_warning(
            f"⚠️ [MBRAIN:tail] {path.name} | "
            f"{type(e).__name__}: {e}"
        )
        return []


# ══════════════════════════════════════════════════════
# ManualBrain
# ══════════════════════════════════════════════════════
class ManualBrain:
    """هوش دستی: لایهٔ اول و مرجع اصلی ربات — صفر تا صد."""

    def __init__(self, db_path: str):
        self.db_path = db_path
        self.api = DataAPI(db_path)
        self._fm = get_formula_manager(db_path)

        self.core_rules: list[dict[str, Any]] = list(DEFAULT_RULES)
        self.learned_rules: list[dict[str, Any]] = []
        self._candidates: list[dict[str, Any]] = []

        self._lock = threading.Lock()
        self.stats: dict[str, dict] = {}
        self._templates_cache: dict[str, str] | None = None

        t0 = time.monotonic()
        self._load_learned()
        self._load_candidates()
        self._load_stats()
        self._cleanup_polluted()
        elapsed_ms = (time.monotonic() - t0) * 1000

        log_success(
            f"✅ [MBRAIN:init] آماده | "
            f"core={len(self.core_rules)} learned={len(self.learned_rules)} "
            f"candidates={len(self._candidates)} stats={len(self.stats)} | "
            f"{elapsed_ms:.0f}ms"
        )

    # ══════════════════════════════════════════════════════
    # بارگذاری + خودپاکسازی
    # ══════════════════════════════════════════════════════
    def _load_json_list(self, path: Path, label: str) -> list[dict] | None:
        """لود لیست JSON — None اگه خطا یا فایل نبود."""
        if not path.exists():
            return None
        try:
            with open(str(path), encoding="utf-8") as f:
                data = json.load(f)
            if not isinstance(data, list):
                log_warning(
                    f"⚠️ [MBRAIN:load:{label}] ساختار نامعتبر | "
                    f"type={type(data).__name__} — رد شد"
                )
                return None
            return data
        except json.JSONDecodeError as e:
            log_warning(
                f"⚠️ [MBRAIN:load:{label}] JSON نامعتبر | "
                f"line={e.lineno} col={e.colno} | {e.msg}"
            )
            return None
        except Exception as e:
            log_warning(
                f"⚠️ [MBRAIN:load:{label}] "
                f"{type(e).__name__}: {e}"
            )
            return None

    def _load_learned(self):
        data = self._load_json_list(LEARNED_FILE, "learned")
        if data is None:
            return
        clean = [r for r in data if self._is_rule_healthy(r)]
        dropped = len(data) - len(clean)
        self.learned_rules = clean
        log_info(
            f"📚 [MBRAIN:load:learned] {len(clean)} قانون بارگذاری شد"
        )
        if dropped:
            log_warning(
                f"🧹 [MBRAIN:load:learned] {dropped} قانون آلوده حذف شد"
            )
            self._write_learned()

    def _load_candidates(self):
        data = self._load_json_list(CANDIDATE_FILE, "candidate")
        if data is None:
            return
        clean = [c for c in data if self._is_rule_healthy(c)]
        dropped = len(data) - len(clean)
        self._candidates = clean
        log_info(
            f"📚 [MBRAIN:load:candidate] {len(clean)} candidate بارگذاری شد"
        )
        if dropped:
            log_warning(
                f"🧹 [MBRAIN:load:candidate] {dropped} candidate آلوده حذف شد"
            )
            self._write_candidates()

    def _cleanup_polluted(self):
        before = len(self.core_rules)
        self.core_rules = [
            r for r in self.core_rules if self._is_rule_healthy(r)
        ]
        if len(self.core_rules) < before:
            log_warning(
                f"🧹 [MBRAIN:cleanup] "
                f"{before - len(self.core_rules)} core rule آلوده حذف شد"
            )

    def _is_rule_healthy(self, rule: dict) -> bool:
        if not isinstance(rule, dict):
            return False
        if not rule.get("triggers") or not isinstance(rule["triggers"], list):
            return False
        action = rule.get("action")
        if not isinstance(action, dict):
            return False
        if action.get("type") == "text":
            text_key = action.get("text_key") or action.get("key")
            if text_key:
                return True
            text = action.get("text", "")
            if not self._is_valid_answer(text):
                return False
        return True

    # ══════════════════════════════════════════════════════
    # نوشتن روی دیسک (atomic)
    # ══════════════════════════════════════════════════════
    @staticmethod
    def _atomic_write_json(path: Path, data: Any) -> bool:
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            tmp = path.with_suffix(".tmp")
            with open(str(tmp), "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
            tmp.replace(path)
            return True
        except Exception as e:
            log_warning(
                f"⚠️ [MBRAIN:write] {path.name} | "
                f"{type(e).__name__}: {e}"
            )
            return False

    def _write_learned(self):
        self._atomic_write_json(LEARNED_FILE, self.learned_rules)

    def _write_candidates(self):
        self._atomic_write_json(CANDIDATE_FILE, self._candidates)

    def _save_learned(self, rule: dict):
        self.learned_rules.append(rule)
        self._write_learned()

    def _load_stats(self):
        if not STATS_FILE.exists():
            return
        try:
            with open(str(STATS_FILE), encoding="utf-8") as f:
                self.stats = json.load(f)
            log_info(
                f"📊 [MBRAIN:load:stats] {len(self.stats)} رکورد بارگذاری شد"
            )
        except json.JSONDecodeError as e:
            log_warning(
                f"⚠️ [MBRAIN:load:stats] JSON نامعتبر | line={e.lineno}"
            )
            self.stats = {}
        except Exception as e:
            log_warning(
                f"⚠️ [MBRAIN:load:stats] {type(e).__name__}: {e}"
            )
            self.stats = {}

    def _save_stats(self):
        self._atomic_write_json(STATS_FILE, self.stats)

    def _bump_stat(self, name: str, key: str):
        with self._lock:
            if name not in self.stats:
                self.stats[name] = {
                    "success": 0, "fail": 0, "last_used": None
                }
            self.stats[name][key] = self.stats[name].get(key, 0) + 1
            self.stats[name]["last_used"] = datetime.now().isoformat()
        self._save_stats()

    # ══════════════════════════════════════════════════════
    # Templates
    # ══════════════════════════════════════════════════════
    def _get_template(self, key: str) -> str:
        if self._templates_cache is None:
            try:
                if TEMPLATES_FILE.exists():
                    with open(
                        str(TEMPLATES_FILE), encoding="utf-8"
                    ) as f:
                        data = json.load(f)
                    self._templates_cache = data.get("templates", {}) or {}
                    log_info(
                        f"📚 [MBRAIN:templates] "
                        f"{len(self._templates_cache)} قالب بارگذاری شد"
                    )
                else:
                    self._templates_cache = {}
                    log_info(
                        f"ℹ️ [MBRAIN:templates] فایل نیست: "
                        f"{TEMPLATES_FILE.name}"
                    )
            except Exception as e:
                log_warning(
                    f"⚠️ [MBRAIN:templates] {type(e).__name__}: {e}"
                )
                self._templates_cache = {}
        return self._templates_cache.get(key, f"📭 قالب «{key}» یافت نشد.")

    # ══════════════════════════════════════════════════════
    # گارد کیفیت پاسخ
    # ══════════════════════════════════════════════════════
    @staticmethod
    def _is_valid_answer(answer: str) -> bool:
        if not answer or not isinstance(answer, str):
            return False
        a = answer.strip()
        if len(a) < _MIN_ANSWER_LEN:
            return False
        if a.startswith(_BAD_ANSWER_PREFIXES):
            return False
        low = a.lower()
        for marker in _BAD_ANSWER_MARKERS:
            if marker.lower() in low:
                return False
        if not re.search(r"[\w\u0600-\u06FF]", a):
            return False
        return True

    @staticmethod
    def _is_valid_trigger(trigger: str) -> bool:
        if not trigger or not isinstance(trigger, str):
            return False
        t = trigger.strip()
        if len(t) < _MIN_TRIGGER_LEN or len(t) > _MAX_TRIGGER_LEN:
            return False
        return True

    # ══════════════════════════════════════════════════════
    # تطبیق قوانین
    # ══════════════════════════════════════════════════════
    @staticmethod
    def _normalize(text: str) -> str:
        t = (text or "").lower()
        t = t.replace("ي", "ی").replace("ك", "ک")
        t = t.replace("\u200c", " ")
        t = re.sub(r"\s+", " ", t).strip()
        return t

    def _match_against(
        self, rules: list[dict], low: str
    ) -> tuple[dict | None, int]:
        best_rule = None
        best_score = 0
        for rule in rules:
            for trigger in rule.get("triggers", []):
                score = 0
                if isinstance(trigger, str):
                    if self._normalize(trigger) in low:
                        score = len(trigger)
                elif isinstance(trigger, list):
                    if all(self._normalize(w) in low for w in trigger):
                        score = sum(len(w) for w in trigger)
                if score > best_score:
                    best_score = score
                    best_rule = rule
        return best_rule, best_score

    def _match_exact(self, text: str) -> tuple[dict | None, int, str]:
        low = self._normalize(text)
        rule, score = self._match_against(self.core_rules, low)
        if rule:
            return rule, score, "core"
        rule, score = self._match_against(self.learned_rules, low)
        if rule:
            return rule, score, "learned"
        return None, 0, ""

    def _match_fuzzy(self, text: str) -> dict | None:
        low = self._normalize(text)
        for _layer, rules in (
            ("core", self.core_rules),
            ("learned", self.learned_rules),
        ):
            best_rule = None
            best_sim = _FUZZY_THRESHOLD
            for rule in rules:
                for trigger in rule.get("triggers", []):
                    if not isinstance(trigger, str):
                        continue
                    t = self._normalize(trigger)
                    if len(t) < 4:
                        continue
                    sim = SequenceMatcher(None, t, low).ratio()
                    if sim > best_sim:
                        best_sim = sim
                        best_rule = rule
            if best_rule:
                return best_rule
        return None

    def _trigger_exists(self, trigger: str) -> bool:
        low = self._normalize(trigger)
        if not low:
            return True
        for rules in (
            self.core_rules, self.learned_rules, self._candidates
        ):
            for rule in rules:
                for t in rule.get("triggers", []):
                    if isinstance(t, str) and self._normalize(t) == low:
                        return True
        return False

    # ══════════════════════════════════════════════════════
    # کلیدواژهها — لود/ذخیره با tier
    # ══════════════════════════════════════════════════════
    def _load_custom_kw(self) -> list[str]:
        """خواندن کلیدواژههای سفارشی — فقط اسمها."""
        return list(self._load_custom_kw_with_tier().keys())

    def _load_custom_kw_with_tier(self) -> dict[str, str]:
        """خواندن کلیدواژههای سفارشی به صورت {name: tier}."""
        if not CUSTOM_KW_FILE.exists():
            return {}
        try:
            with open(str(CUSTOM_KW_FILE), encoding="utf-8") as f:
                data = json.load(f)
        except json.JSONDecodeError as e:
            log_warning(
                f"⚠️ [MBRAIN:kw:load] JSON نامعتبر | "
                f"line={e.lineno} | {e.msg}"
            )
            return {}
        except Exception as e:
            log_warning(
                f"⚠️ [MBRAIN:kw:load] {type(e).__name__}: {e}"
            )
            return {}

        if isinstance(data, list):
            return {
                str(k).strip(): "T1"
                for k in data
                if str(k).strip()
            }

        if isinstance(data, dict):
            kws = data.get("keywords")
            if kws is None:
                log_warning(
                    f"⚠️ [MBRAIN:kw:load] dict بدون «keywords» | "
                    f"کلیدها: {list(data.keys())[:5]}"
                )
                return {}
            if isinstance(kws, dict):
                out: dict[str, str] = {}
                for k, meta in kws.items():
                    name = str(k).strip()
                    if not name:
                        continue
                    if isinstance(meta, dict):
                        tier = str(meta.get("tier", "T1")).upper()
                    elif isinstance(meta, str):
                        tier = meta.upper()
                    else:
                        tier = "T1"
                    if tier not in ("T1", "T2", "T3"):
                        tier = "T1"
                    out[name] = tier
                return out
        return {}

    def _save_custom_kw(
        self, keywords_with_tier: dict[str, str] | None
    ) -> bool:
        """ذخیره کلیدواژهها با tier — atomic.

        🔴 FIX: حالا `None`/خالی را امن handle میکند
        (قبلاً AttributeError روی `None.items()` میداد).
        """
        if not keywords_with_tier:
            log_warning(
                "⚠️ [MBRAIN:kw:save] ورودی خالی/None — رد شد"
            )
            return False

        clean: dict[str, dict[str, str]] = {}
        for k, t in keywords_with_tier.items():
            name = (k or "").strip()
            if not name:
                continue
            tier = str(t or "T1").upper()
            if tier not in ("T1", "T2", "T3"):
                log_warning(
                    f"⚠️ [MBRAIN:kw:save] tier نامعتبر «{t}» برای "
                    f"«{name}» → T1"
                )
                tier = "T1"
            clean[name] = {"tier": tier}

        data = {
            "version": "2.0.0",
            "updated_at": datetime.now().isoformat(),
            "keywords": clean,
        }
        ok = self._atomic_write_json(CUSTOM_KW_FILE, data)
        if ok:
            log_success(
                f"💾 [MBRAIN:kw:save] {len(clean)} کلیدواژه ذخیره شد"
            )
        return ok

    @staticmethod
    def _validate_kw(kw: str) -> tuple[bool, str]:
        if not kw or not isinstance(kw, str):
            return False, "خالی"
        k = kw.strip()
        if len(k) < _MIN_KW_LEN:
            return False, f"حداقل {_MIN_KW_LEN} کاراکتر"
        if len(k) > _MAX_KW_LEN:
            return False, f"حداکثر {_MAX_KW_LEN} کاراکتر"
        if any(c in k for c in ("\n", "\r", "\t")):
            return False, "بدون newline/tab"
        return True, k

    @staticmethod
    def _extract_number(text: str) -> int | None:
        """عدد را از متن استخراج میکند (فارسی/عربی/انگلیسی)."""
        if not text:
            return None
        trans = str.maketrans(
            "۰۱۲۳۴۵۶۷۸۹٠١٢٣٤٥٦٧٨٩",
            "01234567890123456789",
        )
        t = text.translate(trans)
        m = re.search(r"(?:^|\s)(\d{1,5})(?:\s|$)", t)
        if m:
            try:
                return int(m.group(1))
            except ValueError:
                return None
        return None

    @staticmethod
    def _extract_quoted(text: str) -> list[str]:
        """همهٔ عبارتهای داخل « » را برمیگرداند."""
        return [m.strip() for m in re.findall(r"«([^»]+)»", text)]

    # ══════════════════════════════════════════════════════
    # کلیدواژهها — دستورات کاربر
    # ══════════════════════════════════════════════════════

    @staticmethod
    def _extract_value_fallback(
        text: str, action_words: list[str]
    ) -> str | None:
        """اگر « » نبود، مقدار را از متن بدون علامت بیرون میکشد."""
        if not text:
            return None
        t = text.strip()

        t = re.sub(
            r"^\s*(کلید\s*واژه(\s*سفارشی|\s*دستی|\s*ها)?|keyword)"
            r"\s*[:،]?\s*",
            "",
            t,
            flags=re.IGNORECASE,
        )

        for w in action_words:
            t = re.sub(
                rf"\s*{re.escape(w)}\s*",
                " ",
                t,
                flags=re.IGNORECASE,
            )

        t = re.sub(
            r"\s*(را|رو|کن|بکن|بده|بذار|انجام\s*بده)\s*",
            " ",
            t,
        )

        t = re.sub(r"\s+", " ", t).strip()

        if not t or len(t) < 2:
            return None
        return t

    def _handle_keyword_command(self, text: str) -> str | None:
        """مدیریت کلیدواژههای سفارشی — افزودن/ویرایش/حذف/لیست/تغییر سطح."""
        low = self._normalize(text)

        has_kw_word = (
            "کلیدواژه" in low
            or "کلید واژه" in low
            or "کلیدواژهها" in low
            or "کلید واژه ها" in low
            or "keyword" in low
        )
        if not has_kw_word:
            return None

        quoted = self._extract_quoted(text)

        # ─── لیست ───
        if any(w in low for w in [
            "لیست", "list", "نمایش", "چند",
            "چیا", "چهها", "چیه", "چیها",
        ]):
            return self._handle_kw_list(text, low, quoted)

        # ─── تغییر سطح ───
        if any(w in low for w in [
            "تی", "سطح", "وزن", "tier", "level",
            "t1", "t2", "t3",
        ]) and any(w in low for w in ["کن", "بذار", "عوض", "تغییر"]):

            _low_n = low.translate(
                str.maketrans("۰۱۲۳۴۵۶۷۸۹", "0123456789")
            )
            _low_n = (
                _low_n
                .replace("یک", "1")
                .replace("دو", "2")
                .replace("سه", "3")
                .replace("one", "1")
                .replace("two", "2")
                .replace("three", "3")
            )

            target_tier: str | None = None
            for pat, tier in (
                (
                    r"(^|\s)(1|t1|تی\s*1|سطح\s*1|وزن\s*1|level\s*1|tier\s*1)(\s|$)",
                    "T1",
                ),
                (
                    r"(^|\s)(2|t2|تی\s*2|سطح\s*2|وزن\s*2|level\s*2|tier\s*2)(\s|$)",
                    "T2",
                ),
                (
                    r"(^|\s)(3|t3|تی\s*3|سطح\s*3|وزن\s*3|level\s*3|tier\s*3)(\s|$)",
                    "T3",
                ),
            ):
                if re.search(pat, _low_n):
                    target_tier = tier
                    break

            kw_to_change = quoted[0] if quoted else None

            if not kw_to_change and target_tier:
                m = re.search(
                    r"(?:کلید\s*واژه|keyword)\s+(.+?)\s+"
                    r"(?:را\s+)?(?:تی|سطح|وزن|tier|level)\s*"
                    r"(?:1|2|3|۱|۲|۳|یک|دو|سه|one|two|three)",
                    text,
                    flags=re.IGNORECASE,
                )
                if m:
                    kw_to_change = m.group(1).strip()

            if kw_to_change and target_tier:
                return self._change_tier(kw_to_change, target_tier)

            return (
                "📝 قالب تغییر سطح:\n"
                "• با گیومه: «کلیدواژه «کود» را تی 1 کن»\n"
                "• بدون گیومه: «کلیدواژه کود را تی 2 کن»\n"
                "• یا: «کلیدواژه نهاد کشاورزی را سطح 1 کن»"
            )

        # ─── ویرایش ───
        if any(w in low for w in [
            "تغییر", "عوض", "اصلاح", "ویرایش",
            "rename", "edit",
        ]):
            if len(quoted) >= 2:
                return self._edit_keyword(quoted[0], quoted[1])

            m = re.search(
                r"(?:کلید\s*واژه|keyword)\s+(.+?)\s+"
                r"(?:را\s+)?(?:به|to)\s+(.+?)"
                r"(?:\s+(?:تغییر|عوض|اصلاح|ویرایش|کن|بده|بکن))?\s*$",
                text,
                flags=re.IGNORECASE,
            )
            if m:
                old = m.group(1).strip()
                new = m.group(2).strip()
                return self._edit_keyword(old, new)

            return (
                "📝 قالب ویرایش:\n"
                "• با گیومه: «کلیدواژه «قدیمی» را به «جدید» تغییر بده»\n"
                "• بدون گیومه: «کلیدواژه قدیمی را به جدید تغییر بده»"
            )

        # ─── حذف ───
        if any(w in low for w in [
            "حذف", "پاک", "بردار", "remove", "delete",
        ]):
            if quoted:
                return self._remove_keyword(quoted[0])

            val = self._extract_value_fallback(
                text, ["حذف", "پاک", "بردار", "remove", "delete"]
            )
            if val:
                return self._remove_keyword(val)

            return (
                "📝 قالب حذف:\n"
                "• با گیومه: «کلیدواژه «مورد نظر» را حذف کن»\n"
                "• بدون گیومه: «کلیدواژه نهاد کشاورزی را پاک کن»"
            )

        # ─── افزودن ───
        if any(w in low for w in [
            "اضافه", "اضاف", "بذار", "بیفزا",
            "ثبت", "add", "insert",
        ]):
            if quoted:
                tier = self._extract_tier(text)
                return self._add_keyword(quoted[0], tier=tier)

            val = self._extract_value_fallback(
                text,
                ["اضافه", "اضاف", "بیفزا", "ثبت", "add", "insert"],
            )
            if val:
                tier = self._extract_tier(text)
                return self._add_keyword(val, tier=tier)

            return (
                "📝 قالب افزودن:\n"
                "• پیشفرض (T1): «کلیدواژه «کود مایع» را اضافه کن»\n"
                "• با سطح: «کلیدواژه «کود مایع» را سطح 2 اضافه کن»\n"
                "• بدون گیومه: «کلیدواژه کود مایع را اضافه کن»"
            )

        # ─── سؤال «داری؟» ───
        if any(w in low for w in ["دار", "هست", "داری", "exist", "has"]):
            if quoted:
                kw = quoted[0]
                kws = self._load_custom_kw()
                if kw in kws:
                    return f"✅ «{kw}» در کلیدواژههای سفارشی هست."
                try:
                    from analyzers.keyword_finder import (
                        get_keyword_finder,
                    )
                    if kw in get_keyword_finder().keywords:
                        return (
                            f"✅ «{kw}» در محصولات اصلی هست "
                            f"(نه سفارشی)."
                        )
                except Exception as e:
                    log_warning(
                        f"⚠️ [MBRAIN:kw:check] keyword_finder | "
                        f"{type(e).__name__}: {e}"
                    )
                return f"❌ «{kw}» در هیچ لیستی نیست."

            val = self._extract_value_fallback(
                text, ["دار", "هست", "داری", "exist", "has"]
            )
            if val:
                kws = self._load_custom_kw()
                if val in kws:
                    return f"✅ «{val}» در کلیدواژههای سفارشی هست."
                try:
                    from analyzers.keyword_finder import (
                        get_keyword_finder,
                    )
                    if val in get_keyword_finder().keywords:
                        return (
                            f"✅ «{val}» در محصولات اصلی هست "
                            f"(نه سفارشی)."
                        )
                except Exception:
                    pass
                return f"❌ «{val}» در هیچ لیستی نیست."
            return None

        return None

    def _handle_kw_list(
        self, text: str, low: str, quoted: list[str]
    ) -> str:
        """منطق مشترک لیست کلیدواژهها — اصلی/سفارشی/همه."""
        kws = self._load_custom_kw()

        if "سفارشی" in low or "دستی" in low or "custom" in low:
            if not kws:
                return "📭 هیچ کلیدواژهٔ سفارشیای ثبت نشده."
            lines = [f"🔧 {len(kws)} کلیدواژهٔ سفارشی:"]
            for i, k in enumerate(kws[:60], 1):
                lines.append(f"   {i}. {k}")
            if len(kws) > 60:
                lines.append(f"   ... و {len(kws) - 60} مورد دیگر")
            return "\n".join(lines)

        only_main = "اصلی" in low or "main" in low or "محصول" in low

        try:
            from analyzers.keyword_finder import get_keyword_finder
            all_kws = list(get_keyword_finder().keywords)
        except Exception as e:
            return f"❌ خطا در خوندن کلیدواژهها: {e}"

        if only_main:
            custom_set = set(kws)
            source = [k for k in all_kws if k not in custom_set]
            title_prefix = "کلیدواژهٔ اصلی (از محصولات)"
        else:
            source = all_kws
            title_prefix = "کلیدواژه"

        total = len(source)
        if not total:
            return f"📭 هیچ {title_prefix}ای پیدا نشد."

        n = self._extract_number(text)
        if re.search(r"(^|\s)(همه|تمام|کل)(\s|$)", low):
            n = 0

        if n is None:
            n = 100
        if n <= 0 or n >= total:
            show = source
            header = f"🔑 همهٔ {total} {title_prefix}:"
            shown = total
        else:
            show = source[:n]
            header = (
                f"🔑 {total} {title_prefix} — "
                f"نمایش {len(show)} مورد اول:"
            )
            shown = len(show)

        lines = [header]
        for i, k in enumerate(show, 1):
            lines.append(f"   {i}. {k}")
        if shown < total:
            lines.append(
                f"\n💡 برای دیدن بقیه: «لیست {total} کلیدواژه» "
                f"یا «لیست ۲۰۰ کلیدواژه»"
            )
        if kws:
            lines.append(f"\n🔧 {len(kws)} کلیدواژهٔ سفارشی هم داری.")
        return "\n".join(lines)

    def _add_keyword(self, kw: str, tier: str = "T1") -> str:
        ok, msg = self._validate_kw(kw)
        if not ok:
            log_warning(f"⚠️ [MBRAIN:kw:add] نامعتبر | {msg}")
            return f"⛔ کلیدواژه نامعتبر: {msg}"

        tier = (tier or "T1").upper()
        if tier not in ("T1", "T2", "T3"):
            tier = "T1"

        existing = self._load_custom_kw_with_tier()
        if msg in existing:
            log_info(f"ℹ️ [MBRAIN:kw:add] «{msg}» از قبل هست")
            return f"⚠️ «{msg}» از قبل هست."

        try:
            from analyzers.keyword_finder import get_keyword_finder
            if msg in set(get_keyword_finder().keywords):
                log_info(
                    f"ℹ️ [MBRAIN:kw:add] «{msg}» در محصولات اصلی هست"
                )
                return f"⚠️ «{msg}» در محصولات اصلی هست."
        except Exception as e:
            log_warning(
                f"⚠️ [MBRAIN:kw:add] keyword_finder | "
                f"{type(e).__name__}: {e}"
            )

        existing[msg] = tier
        if self._save_custom_kw(existing):
            log_success(
                f"✅ [MBRAIN:kw:add] «{msg}» | tier={tier} | "
                f"total={len(existing)}"
            )
            return (
                f"✅ «{msg}» با سطح {tier} اضافه شد.\n"
                f"🔢 الان {len(existing)} کلیدواژهٔ سفارشی داری.\n"
                f"⏱️ تا ۵ ثانیهٔ دیگه خودکار فعال میشه."
            )
        return "❌ ذخیره ناموفق."

    @staticmethod
    def _extract_tier(text: str) -> str:
        """تشخیص tier از متن — پیشفرض T1."""
        low = (text or "").lower()
        trans = str.maketrans("۰۱۲۳۴۵۶۷۸۹", "0123456789")
        low = low.translate(trans)

        if any(w in low for w in [
            "سطح 2", "سطح2", "رده 2", "رده2",
            "تی 2", "تی2", "tier 2", "tier2",
            "level 2", "level2",
        ]):
            return "T2"
        if any(w in low for w in [
            "سطح 3", "رده 3", "تی 3", "tier 3", "level 3",
        ]):
            return "T3"
        return "T1"

    def _remove_keyword(self, kw: str) -> str:
        kw = (kw or "").strip()
        if not kw:
            return "⛔ اسم کلیدواژه خالیه."
        existing = self._load_custom_kw_with_tier()
        if kw not in existing:
            log_info(f"ℹ️ [MBRAIN:kw:rm] «{kw}» نبود")
            return (
                f"❌ «{kw}» در کلیدواژههای سفارشی نیست.\n"
                f"(فقط کلیدواژههای سفارشی قابل حذفن.)"
            )
        existing.pop(kw, None)
        if self._save_custom_kw(existing):
            log_success(
                f"🗑️ [MBRAIN:kw:rm] «{kw}» حذف شد | "
                f"remaining={len(existing)}"
            )
            return (
                f"🗑️ «{kw}» حذف شد.\n"
                f"🔢 الان {len(existing)} کلیدواژهٔ سفارشی داری."
            )
        return "❌ ذخیره ناموفق."

    def _change_tier(self, kw: str, new_tier: str) -> str:
        kw = (kw or "").strip()
        if not kw:
            return "⛔ اسم کلیدواژه خالیه."
        new_tier = new_tier.upper()
        if new_tier not in ("T1", "T2", "T3"):
            return "⛔ سطح نامعتبر. باید T1 یا T2 یا T3 باشه."
        existing = self._load_custom_kw_with_tier()
        if kw not in existing:
            return (
                f"❌ «{kw}» در کلیدواژههای سفارشی نیست.\n"
                f"(فقط کلیدواژههای سفارشی قابل تغییر سطحن.)"
            )
        old_tier = existing.get(kw, "T1")
        if old_tier == new_tier:
            return f"⚠️ «{kw}» از قبل سطح {new_tier} هست."
        existing[kw] = new_tier
        if self._save_custom_kw(existing):
            log_success(
                f"✅ [MBRAIN:kw:tier] «{kw}» | "
                f"{old_tier} → {new_tier}"
            )
            return (
                f"✅ «{kw}» از {old_tier} به {new_tier} تغییر کرد.\n"
                f"⏱️ تا ۵ ثانیهٔ دیگه خودکار فعال میشه."
            )
        return "❌ ذخیره ناموفق."

    def _edit_keyword(self, old: str, new: str) -> str:
        old = (old or "").strip()
        new = (new or "").strip()
        ok, msg = self._validate_kw(new)
        if not ok:
            return f"⛔ کلیدواژهٔ جدید نامعتبر: {msg}"
        if old == new:
            return "⚠️ اسم قدیم و جدید یکیه."
        existing = self._load_custom_kw_with_tier()
        if old not in existing:
            return f"❌ «{old}» در کلیدواژههای سفارشی نیست."
        if new in existing:
            return f"⚠️ «{new}» از قبل در لیست هست."
        tier = existing.pop(old, "T1")
        existing[new] = tier
        if self._save_custom_kw(existing):
            log_success(f"✏️ [MBRAIN:kw:edit] «{old}» → «{new}»")
            return (
                f"✏️ «{old}» → «{new}»\n"
                f"⏱️ تا ۵ ثانیهٔ دیگه خودکار فعال میشه."
            )
        return "❌ ذخیره ناموفق."

    # ══════════════════════════════════════════════════════
    # خطاها: خواندن و فهم
    # ══════════════════════════════════════════════════════
    def _read_recent_logs(self, limit: int = 500) -> list[dict]:
        """آخرین خطوط لاگ — با seek از انتها."""
        lines = _tail_lines(LOG_FILE, _LOG_TAIL_BYTES)
        if not lines:
            return []
        out: list[dict] = []
        invalid = 0
        for ln in reversed(lines):
            if len(out) >= limit:
                break
            try:
                out.append(json.loads(ln))
            except Exception:
                invalid += 1
                continue
        if invalid:
            log_info(
                f"ℹ️ [MBRAIN:logs] {invalid} خط نامعتبر رد شد"
            )
        out.reverse()
        return out

    def _get_recent_errors(
        self, hours: int = 24, limit: int = 20
    ) -> list[dict]:
        cutoff = datetime.now() - timedelta(hours=hours)
        logs = self._read_recent_logs(1000)
        errors: list[dict] = []
        for entry in reversed(logs):
            if entry.get("level") not in ("ERROR", "CRITICAL"):
                continue
            try:
                ts = entry.get("ts", "")
                when = datetime.fromisoformat(
                    ts.replace("Z", "+00:00")
                ).replace(tzinfo=None)
                if when < cutoff:
                    continue
            except Exception:
                pass
            errors.append(entry)
            if len(errors) >= limit:
                break
        return errors

    def _handle_error_command(self, text: str) -> str | None:
        low = self._normalize(text)
        if not any(w in low for w in [
            "خطا", "error", "خرابی", "مشکل",
            "ایراد", "ارور",
        ]):
            return None

        if any(w in low for w in [
            "توضیح", "بگو", "چیه", "یعنی", "چرا",
            "explain", "فهم", "بخوان", "بخون",
        ]):
            errors = self._get_recent_errors(hours=24, limit=15)
            if not errors:
                return "✅ در ۲۴ ساعت اخیر هیچ خطایی در لاگ نبود."
            return self._explain_errors(errors)

        if any(w in low for w in ["چند", "تعداد", "count", "شمردن"]):
            errors = self._get_recent_errors(hours=24, limit=1000)
            if not errors:
                return "✅ در ۲۴ ساعت اخیر خطایی ثبت نشده."
            by_level: dict[str, int] = {}
            for e in errors:
                lv = e.get("level", "?")
                by_level[lv] = by_level.get(lv, 0) + 1
            lines = [f"⚠️ {len(errors)} خطا در ۲۴ ساعت اخیر:"]
            for lv, n in sorted(
                by_level.items(), key=lambda x: -x[1]
            ):
                lines.append(f"   • {lv}: {n}")
            return "\n".join(lines)

        if any(w in low for w in [
            "لاگ", "log", "لیست", "نمایش",
            "اخیر", "آخرین",
        ]):
            errors = self._get_recent_errors(hours=24, limit=10)
            if not errors:
                return "✅ در ۲۴ ساعت اخیر هیچ خطایی نبود."
            lines = [f"🗒️ آخرین {len(errors)} خطا:"]
            for e in errors:
                ts = str(e.get("ts", ""))[:19].replace("T", " ")
                msg = str(e.get("msg", ""))[:100]
                lines.append(f"   [{ts}] {e.get('level','?')}: {msg}")
            return "\n".join(lines)

        return None

    def _explain_errors(self, errors: list[dict]) -> str:
        categories = {
            "شبکه/اتصال": [
                "ConnectionError", "timed out", "TimeoutError",
                "Connection refused", "502", "Bad Gateway",
                "failed to connect",
            ],
            "محدودیت AI": [
                "402", "Insufficient Balance", "rate limit",
                "429", "موجودی",
            ],
            "نشست/ورود": [
                "session", "login", "expired", "unauthorized",
                "401", "403",
            ],
            "دیتابیس": [
                "database", "sqlite", "no such table", "locked", "sql",
            ],
            "سلکتور/DOM": [
                "selector", "not found", "element", "timeout",
                "waiting for",
            ],
            "مرورگر": [
                "chromium", "chrome", "browser", "playwright",
                "executable",
            ],
            "کلیدواژه": ["keyword", "کلیدواژه"],
            "عمومی": [],
        }
        classified: dict[str, list[dict]] = {k: [] for k in categories}
        for e in errors:
            msg = (
                str(e.get("msg", "")) + " "
                + str(e.get("context", ""))
            )
            placed = False
            for cat, hints in categories.items():
                if cat == "عمومی":
                    continue
                for hint in hints:
                    if hint.lower() in msg.lower():
                        classified[cat].append(e)
                        placed = True
                        break
                if placed:
                    break
            if not placed:
                classified["عمومی"].append(e)

        lines = [f"🧠 توضیح {len(errors)} خطای اخیر:"]
        for cat, items in classified.items():
            if not items:
                continue
            lines.append(f"\n📌 {cat} ({len(items)} مورد)")
            for e in items[:3]:
                msg = str(e.get("msg", ""))[:120]
                lines.append(f"   • {msg}")
            if len(items) > 3:
                lines.append(f"   ... و {len(items) - 3} مورد دیگر")

        lines.append("\n💡 پیشنهاد:")
        suggestions_added = False
        if classified["محدودیت AI"]:
            lines.append(
                "   • شارژ DeepSeek تموم شده → شارژ کن "
                "یا AI_PRIORITY=ollama بذار"
            )
            suggestions_added = True
        if classified["نشست/ورود"]:
            lines.append(
                "   • نشست منقضی شده → python login.py رو دوباره اجرا کن"
            )
            suggestions_added = True
        if classified["شبکه/اتصال"]:
            lines.append(
                "   • مشکل شبکه → پروکسی/VPN رو چک کن (BROWSER_PROXY در .env)"
            )
            suggestions_added = True
        if classified["سلکتور/DOM"]:
            lines.append(
                "   • DOM پلتفرم تغییر کرده → dump_dom رو چک کن و selector آپدیت کن"
            )
            suggestions_added = True
        if classified["مرورگر"]:
            lines.append(
                "   • مرورگر نیست/بسته → CHROME_PATH رو در .env چک کن"
            )
            suggestions_added = True
        if classified["دیتابیس"]:
            lines.append(
                "   • دیتابیس → storage/database/messages.db رو چک کن"
            )
            suggestions_added = True
        if not suggestions_added:
            lines.append(
                "   • خطاهای عمومی → storage/logs/app.jsonl رو دستی ببین"
            )

        return "\n".join(lines)

    # ══════════════════════════════════════════════════════
    # اجرای action
    # ══════════════════════════════════════════════════════
    def _execute_action(self, action: dict, text: str) -> str | None:
        if not isinstance(action, dict):
            return None
        t = action.get("type")
        t0 = time.monotonic()
        result: str | None = None

        try:
            if t == "sql_scalar":
                v = self.api.scalar(
                    action["sql"], tuple(action.get("params", []))
                )
                tmpl = action.get("template", "{v}")
                result = tmpl.format(v=v)
            elif t == "sql_row":
                row = self.api.row(
                    action["sql"], tuple(action.get("params", []))
                )
                if not row:
                    result = action.get("empty", "📭 نتیجهای یافت نشد")
                else:
                    try:
                        result = action.get("template", "").format(**row)
                    except KeyError as e:
                        result = f"⚠️ ستون ناموجود: {e}"
            elif t == "sql_rows":
                rows = self.api.sql(
                    action["sql"], tuple(action.get("params", []))
                )
                if not rows:
                    result = action.get("empty", "📭 نتیجهای یافت نشد")
                else:
                    tmpl = action.get("row_template", "• {0}")
                    out = [action.get("header", "")]
                    for r in rows:
                        try:
                            out.append(tmpl.format(**r))
                        except Exception:
                            out.append(
                                "• " + " | ".join(
                                    str(v) for v in r.values()
                                )
                            )
                    result = "\n".join(s for s in out if s)
            elif t == "text":
                if action.get("text"):
                    result = action["text"]
                else:
                    text_key = action.get("text_key")
                    result = (
                        self._get_template(text_key) if text_key else ""
                    )
            elif t == "text_key":
                key = action.get("key") or action.get("text_key")
                result = self._get_template(key) if key else ""
            elif t == "template":
                ctx = {
                    "leads_total": self.api.leads_total(),
                    "leads_today": self.api.leads_today(),
                    "leads_yesterday": self.api.leads_yesterday(),
                    "leads_last_7d": self.api.leads_last_n_days(7),
                    "leads_last_30d": self.api.leads_last_n_days(30),
                    "hot_total": self.api.hot_total(),
                    "hot_today": self.api.hot_today(),
                    "keyword_count": self.api.keyword_count(),
                    "custom_kw_count": len(self.api.custom_keywords()),
                    "target_group_count": len(self.api.target_groups()),
                    "errors_recent": self.api.error_count_recent(),
                }
                result = action.get("template", "").format(**ctx)
            elif t == "callable":
                fn = action.get("function", "")
                result = self._call_builtin(fn, text)
        except Exception as e:
            log_warning(
                f"⚠️ [MBRAIN:exec:{t}] {type(e).__name__}: {e}"
            )
            return f"⚠️ خطا: {e}"
        finally:
            elapsed_ms = (time.monotonic() - t0) * 1000
            if elapsed_ms > _SLOW_ACTION_MS:
                log_warning(
                    f"🐌 [MBRAIN:exec:{t}] کند | {elapsed_ms:.0f}ms"
                )

        return result

    # ══════════════════════════════════════════════════════
    # اجرای کد پایتون
    # ══════════════════════════════════════════════════════
    def _handle_python_command(self, text: str) -> str | None:
        """اجرای کد پایتون — نوشتن فقط در storage/reports/."""
        low = self._normalize(text)

        SAFE_PREAMBLE = (
            "import builtins, os, io, sys\n"
            "from pathlib import Path as _P\n"
            "_ALLOWED = [\n"
            "    os.path.abspath('storage/reports'),\n"
            "]\n"
            "def _ok(p):\n"
            "    ap = os.path.abspath(str(p))\n"
            "    for d in _ALLOWED:\n"
            "        if ap == d or ap.startswith(d + os.sep): return True\n"
            "    return False\n"
            "def _deny(p):\n"
            "    raise PermissionError(\n"
            "        '\\u26d4 ONLY READ (or write in storage/reports/) — blocked: '\n"
            "        + str(p)\n"
            "    )\n"
            "_ro = builtins.open\n"
            "def _so(f, m='r', *a, **k):\n"
            "    if any(c in str(m) for c in 'wax+'):\n"
            "        if not _ok(f): _deny(f)\n"
            "        try:\n"
            "            os.makedirs(os.path.dirname(os.path.abspath(str(f))), exist_ok=True)\n"
            "        except Exception: pass\n"
            "    return _ro(f, m, *a, **k)\n"
            "builtins.open = _so\n"
            "io.open = _so\n"
            "_wt = _P.write_text\n"
            "def _swt(self, *a, **k):\n"
            "    if not _ok(self): _deny(self)\n"
            "    self.parent.mkdir(parents=True, exist_ok=True)\n"
            "    return _wt(self, *a, **k)\n"
            "_P.write_text = _swt\n"
            "_wb = _P.write_bytes\n"
            "def _swb(self, *a, **k):\n"
            "    if not _ok(self): _deny(self)\n"
            "    self.parent.mkdir(parents=True, exist_ok=True)\n"
            "    return _wb(self, *a, **k)\n"
            "_P.write_bytes = _swb\n"
            "_t = _P.touch\n"
            "def _st(self, *a, **k):\n"
            "    if not _ok(self): _deny(self)\n"
            "    return _t(self, *a, **k)\n"
            "_P.touch = _st\n"
            "_u = _P.unlink\n"
            "def _su(self, *a, **k):\n"
            "    if not _ok(self): _deny(self)\n"
            "    return _u(self, *a, **k)\n"
            "_P.unlink = _su\n"
            "_r = _P.rmdir\n"
            "def _sr(self, *a, **k):\n"
            "    if not _ok(self): _deny(self)\n"
            "    return _r(self, *a, **k)\n"
            "_P.rmdir = _sr\n"
            "_mk = _P.mkdir\n"
            "def _smk(self, *a, **k):\n"
            "    if not _ok(self): _deny(self)\n"
            "    return _mk(self, *a, **k)\n"
            "_P.mkdir = _smk\n"
            "import runpy as _rp\n"
        )

        if "python_file:" in low or "پایتون فایل:" in low:
            m = re.search(
                r"(?:python_file|پایتون فایل)\s*:\s*(\S+)",
                text, re.IGNORECASE,
            )
            if not m:
                return "🐍 مثال: python_file: data/test.py"
            rel_path = m.group(1).strip()
            full_path = os.path.join(str(ROOT), rel_path)
            if not os.path.exists(full_path):
                return f"⚠️ فایل پیدا نشد: {rel_path}"
            if not full_path.endswith(".py"):
                return "⛔ فقط فایلهای .py مجاز هستند."

            try:
                file_code = open(full_path, encoding="utf-8").read()
            except Exception as e:
                return f"❌ خطا در خواندن فایل: {e}"

            for pat in (
                r"\bos\.(system|popen|fork|exec|remove|unlink|rmdir|rename|chmod|makedirs|mkdir)\b",
                r"\bsubprocess\b",
                r"\b__import__\b",
                r"\beval\b", r"\bexec\b", r"\bcompile\b",
                r"\bshutil\.\w+\b",
                r"\bos\.replace\b",
                r"\bos\.truncate\b",
            ):
                if re.search(pat, file_code, re.IGNORECASE):
                    log_warning(f"⛔ [MBRAIN:pyfile] الگو | {pat}")
                    return f"⛔ فایل شامل الگوی ممنوعه است: {pat}"

            full_code = (
                SAFE_PREAMBLE
                + f"_rp.run_path({full_path!r}, run_name='__main__')\n"
            )
            try:
                t0 = time.monotonic()
                r = subprocess.run(
                    [sys.executable, "-c", full_code],
                    capture_output=True, text=True, timeout=30,
                    encoding="utf-8", errors="replace", cwd=str(ROOT),
                )
                elapsed_ms = (time.monotonic() - t0) * 1000
                out = (r.stdout or "") + (r.stderr or "")
                if not out.strip():
                    out = "(بدون خروجی)"
                log_success(
                    f"🐍 [MBRAIN:pyfile] {rel_path} | rc={r.returncode} | "
                    f"{elapsed_ms:.0f}ms"
                )
                icon = "✅" if r.returncode == 0 else "⚠️"
                return (
                    f"{icon} فایل {rel_path} اجرا شد "
                    f"(rc={r.returncode}):\n{out[:2000]}"
                )
            except subprocess.TimeoutExpired:
                return "⏰ اجرای فایل بیش از ۳۰ ثانیه طول کشید."
            except Exception as e:
                return f"❌ خطا: {e}"

        triggers = (
            "python:", "پایتون:", ">>>",
            "اجرا کن پایتون", "python run",
        )
        if not any(t in low for t in triggers):
            return None

        code = None
        m = re.search(
            r"```(?:python|py)?\s*\n?(.+?)```", text, re.DOTALL
        )
        if m:
            code = m.group(1).strip()
        if not code:
            m = re.search(
                r"(?:python|پایتون)\s*:\s*(.+)",
                text, re.DOTALL | re.IGNORECASE,
            )
            if m:
                code = m.group(1).strip()
        if not code:
            return (
                "🐍 قواعد:\n"
                "• خواندن همهجا ✅\n"
                "• نوشتن فقط در storage/reports/ ✅\n"
                "• ویرایش/حذف فایلهای اصلی ⛔\n\n"
                "مثال: python: print(open('core/brain.py').read()[:200])"
            )

        danger = [
            r"\bos\.(system|popen|fork|exec|remove|unlink|rmdir|rename|chmod)\b",
            r"\bsubprocess\b",
            r"\b__import__\b",
            r"\beval\b", r"\bexec\b", r"\bcompile\b",
            r"\bshutil\.(rmtree|remove|move|copy|copy2|copyfile)\b",
            r"\bos\.replace\b",
            r"\bos\.truncate\b",
        ]
        for pat in danger:
            if re.search(pat, code, re.IGNORECASE):
                log_warning(
                    f"⛔ [MBRAIN:py] الگو | {pat} | code={code[:60]!r}"
                )
                return f"⛔ این کد ممنوع است (شامل «{pat}»)."

        sql_write = re.search(
            r"\.execute\s*\(\s*['\"](?:\s*)(DELETE|UPDATE|INSERT|DROP|ALTER|TRUNCATE|CREATE|REPLACE)\b",
            code, re.IGNORECASE,
        )
        if sql_write:
            log_warning(
                f"⛔ [MBRAIN:py] SQL نوشتنی | "
                f"keyword={sql_write.group(1)}"
            )
            return (
                f"⛔ کوئری نوشتنی ({sql_write.group(1)}) "
                f"روی دیتابیس ممنوع است."
            )

        full_code = SAFE_PREAMBLE + "\n" + code
        t0 = time.monotonic()
        try:
            r = subprocess.run(
                [sys.executable, "-c", full_code],
                capture_output=True, text=True, timeout=10,
                encoding="utf-8", errors="replace", cwd=str(ROOT),
            )
            elapsed_ms = (time.monotonic() - t0) * 1000
            out = (r.stdout or "") + (r.stderr or "")
            if not out.strip():
                out = "(بدون خروجی)"
            log_success(
                f"🐍 [MBRAIN:py] rc={r.returncode} | "
                f"{elapsed_ms:.0f}ms | len={len(code)}"
            )
            icon = "✅" if r.returncode == 0 else "⚠️"
            return f"{icon} کد اجرا شد (rc={r.returncode}):\n{out[:1500]}"
        except subprocess.TimeoutExpired:
            log_warning("⏰ [MBRAIN:py] timeout")
            return "⏰ کد بیش از ۱۰ ثانیه طول کشید و متوقف شد."
        except Exception as e:
            log_error(f"❌ [MBRAIN:py] {type(e).__name__}: {e}")
            return f"❌ خطا در اجرا: {e}"

    # ══════════════════════════════════════════════════════
    # مدیریت تنظیمات و پلتفرمها
    # ══════════════════════════════════════════════════════
    def _handle_settings_command(self, text: str) -> str | None:
        """مدیریت تنظیمات و پلتفرمها — بدون AI."""
        low = self._normalize(text)

        if any(w in low for w in [
            "وضعیت پلتفرم", "پلتفرمها", "همه پلتفرم",
        ]):
            return self._show_platform_status()

        _AMBIGUOUS = {"بله", "وب", "سایت", "web"}

        for p_fa, p_code in _PLATFORM_FA.items():
            if p_fa in _AMBIGUOUS:
                pattern = (
                    r"(?:پلتفرم|سرویس|بات)\s+"
                    + re.escape(p_fa)
                    + r"([\s،.:؛!?؟]|$)"
                )
            else:
                pattern = (
                    r"(^|[\s،.:؛!?؟])"
                    + re.escape(p_fa)
                    + r"([\s،.:؛!?؟]|$)"
                )
            if not re.search(pattern, low):
                continue
            if any(w in low for w in [
                "خاموش", "ببند", "غیرفعال",
                "disable", "off",
            ]):
                return self._toggle_platform(p_code, False)
            if any(w in low for w in [
                "روشن", "فعال", "باز کن",
                "enable", "on",
            ]):
                return self._toggle_platform(p_code, True)
            m = re.search(r"(\d+)\s*ثانیه", low)
            if m and any(w in low for w in [
                "poll", "پول", "فاصله", "زمان",
            ]):
                return self._change_poll(p_code, int(m.group(1)))
            if any(w in low for w in [
                "وضعیت", "کار", "وصل", "فعال",
            ]):
                return self._show_one_platform(p_code)

        if "تنظیم" in low or "ست کن" in low or "بذار" in low:
            m = re.search(r"([A-Z_]{3,})\s*[=:]\s*(\S+)", text)
            if m:
                return self._set_setting(m.group(1), m.group(2))

        if "دسترسی" in low or "access" in low:
            if _ACCESS_AVAILABLE:
                return get_access_manager().get_summary()
            return "⚠️ access_manager در دسترس نیست."

        return None

    def _show_platform_status(self) -> str:
        try:
            from config import PLUGINS_CONFIG
            lines = ["📊 وضعیت پلتفرمها:"]
            platforms = (
                "eitaa", "bale", "rubika", "telegram",
                "whatsapp", "web", "linkedin",
            )
            for p in platforms:
                cfg = PLUGINS_CONFIG.get(f"{p}collector", {})
                enabled = cfg.get("enabled", False)
                poll = cfg.get("poll_seconds", "-")
                mark = "✅ روشن" if enabled else "❌ خاموش"
                lines.append(f"   • {p}: {mark} | poll: {poll}s")
            return "\n".join(lines)
        except Exception as e:
            log_warning(
                f"⚠️ [MBRAIN:settings:show] "
                f"{type(e).__name__}: {e}"
            )
            return f"❌ خطا: {e}"

    def _show_one_platform(self, p_code: str) -> str:
        try:
            from config import PLUGINS_CONFIG
            cfg = PLUGINS_CONFIG.get(f"{p_code}collector", {})
            enabled = cfg.get("enabled", False)
            poll = cfg.get("poll_seconds", "-")
            mark = "✅ روشن" if enabled else "❌ خاموش"
            return f"📱 {p_code}: {mark} | poll: {poll}s"
        except Exception as e:
            log_warning(
                f"⚠️ [MBRAIN:settings:one] {p_code} | "
                f"{type(e).__name__}: {e}"
            )
            return f"❌ خطا: {e}"

    def _toggle_platform(self, p_code: str, enabled: bool) -> str:
        if _ACCESS_AVAILABLE:
            ok, reason = get_access_manager().can_toggle_platform(
                p_code
            )
            if not ok:
                log_warning(f"⛔ [MBRAIN:platform] {p_code} | {reason}")
                return f"⛔ {reason}"
        return self._set_setting(
            f"{p_code.upper()}_ENABLED",
            "true" if enabled else "false",
        )

    def _change_poll(self, p_code: str, seconds: int) -> str:
        if seconds < 10 or seconds > 86400:
            return "⛔ مقدار باید بین ۱۰ تا ۸۶۴۰۰ ثانیه باشه."
        if _ACCESS_AVAILABLE:
            ok, reason = get_access_manager().can_toggle_platform(
                p_code
            )
            if not ok:
                return f"⛔ {reason}"
        return self._set_setting(
            f"{p_code.upper()}_POLL_SECONDS", str(seconds)
        )

    def _set_setting(self, key: str, value: str) -> str:
        """نوشتن در .env — atomic (tmp + replace)."""
        key_u = key.upper()
        if _ACCESS_AVAILABLE:
            ok, reason = get_access_manager().can_write_setting(key_u)
            if not ok:
                log_warning(
                    f"⛔ [MBRAIN:setting] {key_u} | {reason}"
                )
                return f"⛔ {reason}"
        try:
            env_path = ROOT / ".env"
            lines: list[str] = []
            if env_path.exists():
                with open(str(env_path), encoding="utf-8") as f:
                    lines = f.readlines()
            found = False
            for i, ln in enumerate(lines):
                if ln.strip().startswith(f"{key_u}="):
                    lines[i] = f"{key_u}={value}\n"
                    found = True
                    break
            if not found:
                lines.append(f"{key_u}={value}\n")
            tmp = env_path.with_suffix(".tmp")
            with open(str(tmp), "w", encoding="utf-8") as f:
                f.writelines(lines)
            tmp.replace(env_path)
            log_success(
                f"💾 [MBRAIN:setting] {key_u}={value} | "
                f"{'بهروز' if found else 'جدید'}"
            )
            return (
                f"✅ {key_u}={value} ذخیره شد.\n"
                f"(برای اعمال، ریاستارت کن.)"
            )
        except Exception as e:
            log_error(
                f"❌ [MBRAIN:setting] {key_u} | "
                f"{type(e).__name__}: {e}"
            )
            return f"❌ خطا: {e}"

    # ══════════════════════════════════════════════════════
    # callables
    # ══════════════════════════════════════════════════════
    def _call_builtin(self, fn: str, text: str) -> str | None:
        p = self._extract_platform(text)

        if fn == "keyword_count":
            return f"🔑 تعداد کلیدواژهها: {self.api.keyword_count()}"
        if fn == "keyword_list":
            return self._handle_kw_list(
                text, self._normalize(text), []
            )
        if fn == "custom_keyword_list":
            kws = self.api.custom_keywords()
            if not kws:
                return "📭 هیچ کلیدواژهٔ سفارشیای ثبت نشده."
            return (
                f"🔧 {len(kws)} کلیدواژهٔ سفارشی:\n"
                + "\n".join(f"• {k}" for k in kws[:30])
            )
        if fn == "target_group_list":
            gs = self.api.target_groups()
            if not gs:
                return "📭 هیچ گروه هدفی تعریف نشده (همه قبولند)."
            return (
                f"🎯 {len(gs)} گروه هدف:\n"
                + "\n".join(f"• {g}" for g in gs[:30])
            )
        if fn == "today_by_platform":
            rows = self.api.sql(
                "SELECT platform, COUNT(*) as n FROM messages "
                "WHERE keywords!='' AND date(timestamp)=date('now') "
                "GROUP BY platform ORDER BY n DESC"
            )
            if not rows:
                return "📭 امروز سرنخی نیست."
            if p:
                for r in rows:
                    if r["platform"] == p:
                        return f"📊 امروز {p}: {r['n']} سرنخ"
                return f"📊 امروز {p}: 0 سرنخ"
            lines = ["📊 امروز به تفکیک:"]
            for r in rows:
                lines.append(f"   • {r['platform']}: {r['n']}")
            return "\n".join(lines)
        if fn == "platform_status":
            if not p:
                return "ℹ️ کدام پلتفرم؟ مثال: «ایتا کار میکند؟»"
            last = self.api.platform_last_poll(p)
            if not last:
                return f"ℹ️ {p}: هنوز فعالیتی ثبت نشده."
            mins = (datetime.now() - last).total_seconds() / 60
            if mins < 30:
                return f"✅ {p}: فعال — {int(mins)} دقیقه پیش"
            return f"⚠️ {p}: آخرین فعالیت {int(mins)} دقیقه پیش"
        if fn == "top_keywords":
            rows = self.api.top_keywords(10, 30)
            if not rows:
                return "📭 کلیدواژهای در ۳۰ روز اخیر نیست."
            return (
                "🔥 پرتکرارترین کلیدواژهها (۳۰ روز):\n"
                + "\n".join(
                    f"   • {r['keyword']}: {r['count']}"
                    for r in rows
                )
            )
        if fn == "top_groups":
            rows = self.api.top_groups(10, 30)
            if not rows:
                return "📭 گروهی در ۳۰ روز اخیر نیست."
            return (
                "🏆 پرسرنخترین گروهها (۳۰ روز):\n"
                + "\n".join(
                    f"   • {r['chat_name']} ({r['platform']}): {r['n']}"
                    for r in rows
                )
            )
        if fn == "last_lead":
            r = self.api.last_lead(platform=p)
            if not r:
                if p:
                    return f"📭 هنوز سرنخی از {p} نیست."
                return "📭 هنوز سرنخی نیست."
            label = f"آخرین ({p})" if p else "آخرین"
            return self._format_lead(r, label)
        if fn == "first_lead":
            r = self.api.first_lead(platform=p)
            if not r:
                if p:
                    return f"📭 هنوز سرنخی از {p} نیست."
                return "📭 هنوز سرنخی نیست."
            label = f"اولین سرنخ {p}" if p else "اولین سرنخ"
            return self._format_lead(r, label)
        if fn == "recent_logs":
            logs = self.api.recent_logs(10)
            if not logs:
                return "📭 لاگی نیست."
            return "🗒️ آخرین لاگها:\n" + "\n".join(
                f"[{l.get('level','')}] {l.get('msg','')[:90]}"
                for l in logs
            )
        if fn == "error_count":
            return (
                f"⚠️ تعداد خطا در لاگِ اخیر: "
                f"{self.api.error_count_recent()}"
            )
        if fn == "recent_reports":
            rs = self.api.recent_reports(10)
            if not rs:
                return "📭 گزارشی نیست."
            return "📁 آخرین گزارشها:\n" + "\n".join(
                f"   • {r['name']} ({r['size_kb']:.1f}KB)"
                for r in rs
            )
        if fn == "system_snapshot":
            s = self.api.system_snapshot()
            lines = [
                "📊 خلاصهٔ سیستم:",
                f"   • کل سرنخها: {s['leads_total']}",
                f"   • امروز: {s['leads_today']} | "
                f"دیروز: {s['leads_yesterday']}",
                f"   • ۷ روز: {s['leads_last_7d']} | "
                f"۳۰ روز: {s['leads_last_30d']}",
                f"   • داغ: {s['hot_total']} "
                f"(امروز: {s['hot_today']})",
                f"   • کلیدواژهها: {s['keyword_count']} | "
                f"سفارشی: {s['custom_kw_count']}",
                f"   • گروه هدف: {s['target_group_count']}",
                f"   • خطاهای اخیر: {s['errors_recent']}",
            ]
            if s["by_platform"]:
                lines.append("   • به تفکیک پلتفرم:")
                for r in s["by_platform"]:
                    lines.append(f"       {r['platform']}: {r['n']}")
            return "\n".join(lines)
        if fn == "compare_days":
            d = self.api.compare_today_yesterday()
            arrow = (
                "📈" if d["diff"] > 0
                else ("📉" if d["diff"] < 0 else "➡️")
            )
            return (
                f"📊 مقایسه:\n"
                f"   امروز: {d['today']}\n"
                f"   دیروز: {d['yesterday']}\n"
                f"   {arrow} اختلاف: {d['diff']:+d}"
            )
        if fn == "today_hourly":
            rows = self.api.leads_by_hour_today()
            if not rows:
                return "📭 امروز هنوز سرنخی نیست."
            return "🕐 امروز به تفکیک ساعت:\n" + "\n".join(
                f"   • {r['hour']}:00 → {r['n']}" for r in rows
            )
        if fn == "hot_recent":
            rows = self.api.recent_hot_leads(5)
            if not rows:
                return "📭 سرنخ داغی نیست."
            return "🔥 ۵ سرنخ داغ اخیر:\n" + "\n".join(
                f"   • [{r['platform']}] {r['chat_name']} "
                f"(امتیاز {r['opportunity_score']})\n"
                f"     {r['text'][:80]}..."
                for r in rows
            )
        if fn == "high_score":
            rows = self.api.high_score_leads(50, 10)
            if not rows:
                return "📭 سرنخ با امتیاز بالا نیست."
            return "⭐ ۱۰ سرنخ قوی:\n" + "\n".join(
                f"   • [{r['platform']}] {r['chat_name']} | "
                f"{r['keywords']} | {r['opportunity_score']}"
                for r in rows
            )
        if fn == "silent_groups":
            rows = self.api.silent_groups(7)
            if not rows:
                return "✅ همهٔ گروهها فعالن."
            return (
                f"😴 {len(rows)} گروه ساکت (۷ روز اخیر):\n"
                + "\n".join(
                    f"   • {r['chat_name']} "
                    f"(آخرین: {r['last_seen'][:10]})"
                    for r in rows
                )
            )
        if fn == "by_platform":
            rows = self.api.sql(
                "SELECT platform, COUNT(*) as n FROM messages "
                "WHERE keywords!='' GROUP BY platform ORDER BY n DESC"
            )
            if not rows:
                return "📭 هنوز سرنخی ثبت نشده."
            lines = ["📊 تفکیک پلتفرم:"]
            for r in rows:
                lines.append(f"   • {r['platform']}: {r['n']} سرنخ")
            total = sum(r["n"] for r in rows)
            lines.append(f"\n🔑 کل: {total} سرنخ")
            return "\n".join(lines)
        if fn == "top_platform":
            r = self.api.row(
                "SELECT platform, COUNT(*) as n FROM messages "
                "WHERE keywords!='' GROUP BY platform "
                "ORDER BY n DESC LIMIT 1"
            )
            if not r:
                return "📭 هنوز سرنخی ثبت نشده."
            return (
                f"🏆 پرسرنخترین پلتفرم: {r['platform']} "
                f"({r['n']} سرنخ)"
            )
        if fn == "top_group":
            r = self.api.row(
                "SELECT chat_name, platform, COUNT(*) as n FROM messages "
                "WHERE keywords!='' GROUP BY chat_name, platform "
                "ORDER BY n DESC LIMIT 1"
            )
            if not r:
                return "📭 هنوز سرنخی ثبت نشده."
            return (
                f"🏆 پرسرنخترین گروه:\n"
                f"   👥 {r['chat_name']} ({r['platform']})\n"
                f"   🔑 {r['n']} سرنخ"
            )
        return None

    # ══════════════════════════════════════════════════════
    # فرمولها
    # ══════════════════════════════════════════════════════
    def _handle_formula_command(self, text: str) -> str | None:
        low = self._normalize(text)

        if "ذخیره کن" in text or "ذخیره فرمول" in text:
            names = self._extract_quoted(text)
            if not names:
                return "📝 قالب: «ذخیره کن «اسم» = SELECT ...»"
            m = re.search(r"=\s*(.+)", text, re.DOTALL)
            if not m:
                return "📝 قالب: «ذخیره کن «اسم» = SELECT ...»"
            return self._fm.save(names[0], m.group(1).strip())

        if text.startswith("تأیید "):
            names = self._extract_quoted(text)
            if names and self._fm.has_pending_confirm(names[0]):
                return self._fm.execute(names[0], confirm=True)

        if text.startswith("اجرا کن ") or text.startswith("اجرا فرمول "):
            names = self._extract_quoted(text)
            if not names:
                return "📝 قالب: «اجرا کن «اسم»»"
            confirm = ("تأیید" in text or "confirm" in low)
            return self._fm.execute(
                names[0], text=text, confirm=confirm
            )

        if any(w in low for w in [
            "لیست فرمول", "فرمولها", "فرمولها",
            "همه فرمول", "فرمول های",
        ]):
            return self._fm.list_all()

        if text.startswith("نمایش فرمول "):
            names = self._extract_quoted(text)
            if names:
                return self._fm.show(names[0])

        if text.startswith("حذف فرمول "):
            names = self._extract_quoted(text)
            if names:
                return self._fm.delete(names[0])

        return None

    def _format_lead(self, r: dict, label: str) -> str:
        return (
            f"🔎 {label} سرنخ:\n"
            f"📱 پلتفرم: {r.get('platform','?')}\n"
            f"👥 گروه: {r.get('chat_name','?')}\n"
            f"🔑 کلیدواژه: {r.get('keywords','?')}\n"
            f"🎯 {r.get('opportunity_type','-')} "
            f"(امتیاز {r.get('opportunity_score',0)})\n"
            f"🕒 {r.get('timestamp','?')}\n"
            f"💬 {(r.get('text') or '')[:300]}"
            + (
                f"\n🔗 {r['chat_link']}"
                if r.get("chat_link") else ""
            )
        )

    @staticmethod
    def _extract_platform(text: str) -> str | None:
        low = (text or "").lower()
        for fa, code in _PLATFORM_FA.items():
            pattern = (
                r"(^|[\s،.:؛!?؟])"
                + re.escape(fa)
                + r"([\s،.:؛!?؟]|$)"
            )
            if re.search(pattern, low):
                return code
        return None

    # ══════════════════════════════════════════════════════
    # Self-learning
    # ══════════════════════════════════════════════════════
    def _log_unknown(self, text: str, sender: str = None):
        try:
            UNKNOWN_FILE.parent.mkdir(parents=True, exist_ok=True)
            entry = {
                "ts": datetime.now().isoformat(),
                "text": text,
                "sender": sender or "unknown",
                "hash": _md5_short(text),
            }
            with open(str(UNKNOWN_FILE), "a", encoding="utf-8") as f:
                f.write(json.dumps(entry, ensure_ascii=False) + "\n")
            try:
                with open(
                    str(UNKNOWN_FILE), encoding="utf-8"
                ) as f:
                    lines = f.readlines()
                if len(lines) > _MAX_UNKNOWN_LINES:
                    with open(
                        str(UNKNOWN_FILE), "w", encoding="utf-8"
                    ) as f:
                        f.writelines(lines[-_MAX_UNKNOWN_LINES:])
                    log_info(
                        f"🧹 [MBRAIN:unknown] cap | "
                        f"{len(lines)} → {_MAX_UNKNOWN_LINES}"
                    )
            except Exception as e:
                log_warning(
                    f"⚠️ [MBRAIN:unknown:cap] "
                    f"{type(e).__name__}: {e}"
                )
        except Exception as e:
            log_warning(
                f"⚠️ [MBRAIN:unknown] {type(e).__name__}: {e}"
            )

    def _count_repeats(self, text: str) -> int:
        if not UNKNOWN_FILE.exists():
            return 0
        h = _md5_short(text)
        lines = _tail_lines(UNKNOWN_FILE, _UNKNOWN_TAIL_BYTES)
        cnt = 0
        for ln in lines:
            try:
                if json.loads(ln).get("hash") == h:
                    cnt += 1
            except Exception:
                continue
        return cnt

    def learn_from_ai(
        self,
        question: str,
        answer: str,
        source: str = "ai",
        auto_promote: bool = False,
    ) -> bool:
        if not question or not answer:
            return False
        q = question.strip()
        a = answer.strip()

        if not self._is_valid_answer(a):
            log_warning(
                f"⚠️ [MBRAIN:learn] پاسخ نامعتبر | "
                f"{a[:_LOG_PREVIEW_LEN]!r}"
            )
            return False

        if not self._is_valid_trigger(q):
            log_warning(
                f"⚠️ [MBRAIN:learn] trigger نامعتبر | "
                f"{q[:_LOG_PREVIEW_LEN]!r}"
            )
            return False

        if self._trigger_exists(q):
            log_info(
                f"ℹ️ [MBRAIN:learn] trigger «{q[:40]}» "
                f"قبلاً وجود دارد — skip"
            )
            return False

        low = self._normalize(q)
        for c in self._candidates:
            for t in c.get("triggers", []):
                if isinstance(t, str) and self._normalize(t) == low:
                    return False

        rule = {
            "name": f"ai_learned_{int(datetime.now().timestamp())}",
            "triggers": [q],
            "action": {"type": "text", "text": a},
            "learned": True,
            "source": source,
            "created_at": datetime.now().isoformat(),
        }

        if auto_promote:
            self._save_learned(rule)
            log_success(
                f"✅ [MBRAIN:learn] promote مستقیم | «{q[:40]}»"
            )
        else:
            self._candidates.append(rule)
            self._write_candidates()
            log_success(
                f"📝 [MBRAIN:learn] candidate | «{q[:40]}» | "
                f"total={len(self._candidates)}"
            )
        return True

    def promote_candidate(self, name: str) -> bool:
        try:
            promoted = None
            remaining: list[dict] = []
            for r in self._candidates:
                if r.get("name") == name:
                    promoted = r
                else:
                    remaining.append(r)
            if not promoted:
                log_info(f"ℹ️ [MBRAIN:promote] «{name}» نبود")
                return False
            if not self._is_rule_healthy(promoted):
                log_warning(
                    f"⛔ [MBRAIN:promote] «{name}» نامعتبر — حذف"
                )
                self._candidates = remaining
                self._write_candidates()
                return False
            self._candidates = remaining
            self._write_candidates()
            self._save_learned(promoted)
            log_success(
                f"✅ [MBRAIN:promote] «{name}» | "
                f"learned={len(self.learned_rules)} "
                f"candidates={len(self._candidates)}"
            )
            return True
        except Exception as e:
            log_warning(
                f"⚠️ [MBRAIN:promote] {type(e).__name__}: {e}"
            )
            return False

    def list_candidates(self) -> list[dict]:
        return list(self._candidates)

    def reject_candidate(self, name: str) -> bool:
        try:
            before = len(self._candidates)
            self._candidates = [
                c for c in self._candidates
                if c.get("name") != name
            ]
            if len(self._candidates) < before:
                self._write_candidates()
                log_info(f"🗑️ [MBRAIN:reject] «{name}» حذف شد")
                return True
        except Exception as e:
            log_warning(
                f"⚠️ [MBRAIN:reject] {type(e).__name__}: {e}"
            )
        return False

    # ══════════════════════════════════════════════════════
    # یادگیری دستی
    # ══════════════════════════════════════════════════════
    def _handle_learn_command(self, text: str) -> str | None:
        """یادگیری از پیام کاربر با فرمت: «یاد بگیر «سؤال» = «جواب»»."""
        m = re.search(
            r"یاد\s*بگیر[:\s]*(.+?)\s*=\s*(.+)",
            text,
            re.DOTALL,
        )
        if not m:
            return (
                "📝 قالب:\n"
                "• یاد بگیر «سؤال» = «جواب»\n"
                "• یاد بگیر «سؤال» = SQL: SELECT ...\n"
                "• تأیید <candidate_name>\n"
                "• رد <candidate_name>\n"
                "• لیست candidate ها"
            )

        trigger = m.group(1).strip().strip("«»\"'")
        answer = m.group(2).strip().strip("«»\"'")

        if not self._is_valid_trigger(trigger):
            return (
                f"⛔ trigger نامعتبر (طول باید بین "
                f"{_MIN_TRIGGER_LEN} و {_MAX_TRIGGER_LEN} باشد)."
            )

        is_sql = answer.lower().startswith("sql:")
        if is_sql:
            answer = answer[4:].strip()

        if not is_sql and not self._is_valid_answer(answer):
            return "⛔ پاسخ نامعتبر (خالی/کوتاه/خطا)."

        rule_name = f"user_learned_{int(datetime.now().timestamp())}"
        if is_sql:
            rule = {
                "name": rule_name,
                "triggers": [trigger],
                "action": {
                    "type": "sql_scalar",
                    "sql": answer,
                    "template": "📊 {v}",
                },
                "learned": True,
                "source": "user",
                "created_at": datetime.now().isoformat(),
            }
        else:
            rule = {
                "name": rule_name,
                "triggers": [trigger],
                "action": {"type": "text", "text": answer},
                "learned": True,
                "source": "user",
                "created_at": datetime.now().isoformat(),
            }

        self._save_learned(rule)
        log_success(
            f"✅ [MBRAIN:learn:manual] «{trigger[:40]}» | "
            f"type={'sql' if is_sql else 'text'}"
        )
        return f"✅ یاد گرفتم.\n📝 «{trigger}» → «{answer[:100]}»"

    # ══════════════════════════════════════════════════════
    # process — نقطهٔ ورود
    # ══════════════════════════════════════════════════════
    async def process(
        self,
        text: str,
        sender: str = None,
        ai_fallback: Callable | None = None,
    ) -> str | None:
        if not text:
            return None
        text = text.strip()
        t_all = time.monotonic()

        log_info(
            f"▶️ [MBRAIN:process] len={len(text)} | "
            f"in={text[:_LOG_PREVIEW_LEN]!r}"
        )

        # ─── ۰.۰) فرمولها ───
        fm_reply = self._handle_formula_command(text)
        if fm_reply:
            log_info("🎬 [MBRAIN:process] formula branch")
            self._log_timing(t_all, "formula")
            return fm_reply

        # ─── ۰.۱) یاد بگیر / تأیید / رد / candidate ───
        if "یاد بگیر" in text or "یادگیری" in text[:10]:
            r = self._handle_learn_command(text)
            self._log_timing(t_all, "learn")
            return r

        if text.startswith("تأیید ") or text.startswith("تایید "):
            name = (
                text.split(" ", 1)[1].strip().strip("«»\"'")
            )
            if self.promote_candidate(name):
                self._log_timing(t_all, "promote")
                return f"✅ قانون «{name}» فعال شد."
            self._log_timing(t_all, "promote-fail")
            return (
                f"❌ قانون «{name}» در candidate ها "
                f"پیدا نشد یا نامعتبر بود."
            )

        if text.startswith("رد "):
            name = (
                text.split(" ", 1)[1].strip().strip("«»\"'")
            )
            if self.reject_candidate(name):
                self._log_timing(t_all, "reject")
                return f"🗑️ candidate «{name}» حذف شد."
            self._log_timing(t_all, "reject-fail")
            return f"❌ candidate «{name}» پیدا نشد."

        if (
            "لیست candidate" in text.lower()
            or "candidate ها" in text.lower()
        ):
            cands = self.list_candidates()
            if not cands:
                return "📭 هیچ candidate ای نیست."
            lines = [f"📋 {len(cands)} candidate:"]
            for c in cands[:20]:
                trg = (
                    c.get("triggers", [""])[0]
                    if c.get("triggers") else "?"
                )
                lines.append(
                    f"   • {c.get('name')} ← «{str(trg)[:50]}»"
                )
            self._log_timing(t_all, "list-candidates")
            return "\n".join(lines)

        # ─── ۰.۲) کلیدواژهها ───
        kw_reply = self._handle_keyword_command(text)
        if kw_reply:
            log_info("🎬 [MBRAIN:process] keyword branch")
            self._log_timing(t_all, "keyword")
            return kw_reply

        # ─── ۰.۳) خطاها ───
        err_reply = self._handle_error_command(text)
        if err_reply:
            log_info("🎬 [MBRAIN:process] error branch")
            self._log_timing(t_all, "error")
            return err_reply

        # ─── ۰.۴) تنظیمات ───
        settings_reply = self._handle_settings_command(text)
        if settings_reply:
            log_info("🎬 [MBRAIN:process] settings branch")
            self._log_timing(t_all, "settings")
            return settings_reply

        # ─── ۰.۴.۵) پایتون ───
        py_reply = self._handle_python_command(text)
        if py_reply:
            log_info("🎬 [MBRAIN:process] python branch")
            self._log_timing(t_all, "python")
            return py_reply

        # ─── ۰.۵) KEY=VALUE ───
        _m = re.search(r"\b([A-Z_]{4,})\s*[=:]\s*(\S+)", text)
        if _m:
            key, val = _m.group(1), _m.group(2)
            if _ACCESS_AVAILABLE:
                ok, reason = get_access_manager().can_write_setting(
                    key
                )
                if not ok:
                    return f"⛔ {reason}"
                self._log_timing(t_all, "set_param")
                return self._set_setting(key, val)

        # ─── ۱) تطبیق دقیق ───
        rule, score, layer = self._match_exact(text)
        if rule:
            reply = self._execute_action(
                rule.get("action", {}), text
            )
            if reply:
                self._bump_stat(rule.get("name", "?"), "success")
                log_success(
                    f"✅ [MBRAIN:match:exact] [{layer}] "
                    f"{rule.get('name')} | score={score}"
                )
                self._log_timing(t_all, "exact")
                return reply
            self._bump_stat(rule.get("name", "?"), "fail")

        # ─── ۲) تطبیق فازی ───
        fz = self._match_fuzzy(text)
        if fz:
            reply = self._execute_action(
                fz.get("action", {}), text
            )
            if reply:
                self._bump_stat(fz.get("name", "?"), "success")
                log_success(
                    f"✅ [MBRAIN:match:fuzzy] {fz.get('name')}"
                )
                self._log_timing(t_all, "fuzzy")
                return reply

        # ─── ۳) AI fallback ───
        if ai_fallback:
            try:
                t_ai = time.monotonic()
                ai_reply = await ai_fallback(text)
                ai_ms = (time.monotonic() - t_ai) * 1000
                if ai_reply:
                    if not self._is_valid_answer(ai_reply):
                        log_warning(
                            f"⚠️ [MBRAIN:ai] پاسخ نامعتبر — نادیده | "
                            f"{str(ai_reply)[:_LOG_PREVIEW_LEN]!r}"
                        )
                        return None

                    repeats = self._count_repeats(text)
                    auto = (
                        repeats >= _UNKNOWN_MIN_REPEAT
                        and not self._trigger_exists(text)
                    )
                    # 🔴 FIX نسخهٔ ۷: false → False
                    saved = self.learn_from_ai(
                        text, ai_reply,
                        source="ai",
                        auto_promote=False,
                    )
                    if saved and auto:
                        log_success(
                            f"🧠 [MBRAIN:ai] سؤال تکراری "
                            f"({repeats}×) → promote مستقیم"
                        )
                    elif saved:
                        log_info(
                            "📝 [MBRAIN:ai] → candidate "
                            "(نیاز به تأیید)"
                        )
                    log_info(
                        f"🎬 [MBRAIN:process] ai branch | "
                        f"ai={ai_ms:.0f}ms"
                    )
                    self._log_timing(t_all, "ai")
                    return ai_reply
            except Exception as e:
                log_warning(
                    f"⚠️ [MBRAIN:ai] {type(e).__name__}: {e}"
                )

        # ─── ۴) ثبت ناشناخته ───
        self._log_unknown(text, sender)
        log_info("🎬 [MBRAIN:process] ناشناخته — ثبت شد")
        self._log_timing(t_all, "unknown")
        return None

    def _log_timing(self, t0: float, branch: str):
        elapsed_ms = (time.monotonic() - t0) * 1000
        if elapsed_ms > _SLOW_PROCESS_MS:
            log_warning(
                f"🐌 [MBRAIN:process] {branch} کند | "
                f"{elapsed_ms:.0f}ms"
            )


# ══════════════════════════════════════════════════════
# Singleton
# ══════════════════════════════════════════════════════
_shared: ManualBrain | None = None


def get_manual_brain(db_path: str) -> ManualBrain:
    global _shared
    if _shared is None:
        log_info(
            f"🏗️ [MBRAIN:singleton] ساخت نمونهٔ اول | db={db_path}"
        )
        _shared = ManualBrain(db_path)
    return _shared