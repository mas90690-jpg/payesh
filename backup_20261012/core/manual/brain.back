# core/manual/brain.py
"""
هوش دستی پیشرفته — نسخهٔ ۷ (صفر تا صد).

قابلیتهای کامل (بدون AI هم کار میکنن):
  ✅ مدیریت کلیدواژه: افزودن / ویرایش / حذف / لیست / تغییر tier
  ✅ خواندن و فهم خطاها از لاگ
  ✅ دسترسی کامل به دیتابیس (سرنخها، گروهها، آمار)
  ✅ قوانین از rules.json + text_key از templates.json
  ✅ یادگیری از AI (اختیاری): candidate → تأیید → learned
  ✅ ضدِ آلودگی: خطاها هرگز یاد گرفته نمیشن

نسخهٔ ۷ (این نسخه):
  - 🔴 FIX بحرانی: `auto_promote=false` → `auto_promote=False`
    (قبلاً هر بار AI پاسخ می‌داد → NameError → کل process کرش می‌کرد).
  - 🔴 FIX: `_save_custom_kw` حالا `None`/خالی را امن handle می‌کند
    (قبلاً AttributeError روی `None.items()`).
  - ✅ حفظ همهٔ FIXهای نسخهٔ ۶.
"""
from __future__ import annotations

import hashlib
import json
import os
import re
import subprocess
import sys
import threading
import time
from collections.abc import Callable
from datetime import datetime, timedelta
from difflib import SequenceMatcher
from pathlib import Path
from typing import Any

from core.adapters.formula_manager import get_formula_manager
from core.kernel.logger import log_error, log_info, log_success, log_warning
from core.manual.data_api import DataAPI

